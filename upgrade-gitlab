#!/usr/bin/env bash

BACKUP_DIR=
DISCORD_URL=${DISCORD_URL:-}
GITLAB_EDITION=
PULL_PID=
config_backup_hook=${UPGRADE_GITLAB_CONFIG_HOOK:-}
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)" || SCRIPT_DIR=""

skip_latest=0
target_version_tag=
auto_restart_enabled=no
_in_stacktrace=0
edition_flag=
auto_yes=0
dry_run=0
no_step_limit=0
skip_lfs=0
reset_stuck_finalizing=0
max_tier_flag=
_interrupted=0
_trap_active=0
_pull_pid=
_tty=/dev/tty
if ! (: > /dev/tty) 2>/dev/null; then
    _tty=/dev/null
fi
_pull_interrupted=0

# shellcheck disable=SC2329
_handle_signal() {
    if [ "$_trap_active" -eq 1 ]; then
        _interrupted=1
        echo -e "\nSignal received. Will exit at next safe point..." >&2
        return
    fi
    if [ -n "$PULL_PID" ]; then
        kill "$PULL_PID" 2>/dev/null
    fi
    if [ -n "${_size_poller_pid:-}" ]; then
        kill "$_size_poller_pid" 2>/dev/null
    fi
    exit 130
}
trap _handle_signal SIGINT SIGTERM SIGTSTP SIGHUP

# shellcheck disable=SC2329
_pull_signal_handler() {
    if [ -n "$_pull_pid" ]; then
        kill "$_pull_pid" 2>/dev/null
        wait "$_pull_pid" 2>/dev/null
    fi
    _pull_interrupted=1
}

enter_critical() {
    _trap_active=1
    echo "Entering critical section: signals deferred until next safe checkpoint. SIGQUIT (Ctrl+\\) or SIGKILL forces immediate exit." >&2
}
exit_critical() {
    _trap_active=0
    echo "Exiting critical section." >&2
    # _interrupted 처리는 main flow가 담당 — 여기서 exit 안 함.
    # Loop iteration 끝/CE→EE 끝에서 break + post-upgrade 후 최종 exit code 결정.
}

pull_with_retry() {
    local image=$1
    trap _pull_signal_handler SIGINT SIGTERM SIGTSTP SIGHUP

    while true; do
        _pull_interrupted=0
        docker pull "$image" &
        _pull_pid=$!
        wait "$_pull_pid"
        local rc=$?
        _pull_pid=

        if [ $rc -eq 0 ]; then
            break
        elif [ "$_pull_interrupted" -eq 1 ]; then
            echo -e "\nPull interrupted. Restarting download... (Ctrl+\\\\ to force quit)"
            continue
        else
            echo "Error: docker pull failed with exit code $rc" >&2
            trap _handle_signal SIGINT SIGTERM SIGTSTP SIGHUP
            return $rc
        fi
    done

    trap _handle_signal SIGINT SIGTERM SIGTSTP SIGHUP
}

if [ "$1" == "--help" ] || [ "$1" == "help" ]; then
    echo "Usage: $0 [-y] [--edition=ce|ee] [--target-url=http] [--discord-url=http] [--version=0.0.0] [--skip-latest] [--skip-lfs] [--no-step-limit] [--dry-run] [--reset-stuck-finalizing] [--max-tier=core|starter|premium|ultimate]"

    echo -e '\n\e[0;1mOPTIONS\e[m'
    echo -e "-y, --yes\t\tAuto-confirm prompts for unattended/cron usage. Aborts on safety warnings and if upgrade path >= 3 steps. Requires DISCORD_URL unless CI=true."
    echo -e "--help\t\t\tShow this help."
    echo -e "--edition=ce|ee\t\tForce GitLab edition (ce or ee). Auto-detected if omitted."
    echo -e "--version=0.0.0\t\tUse provided tag instead of latest tag. Partial versions (e.g. 18) are resolved automatically. EOS versions are rejected."
    echo -e "--skip-latest\t\tTarget the latest patch of the previous minor version (N-1 strategy). Can combine with major-only --version (e.g. --version=18 --skip-latest). (alias: --n-1)"
    echo -e "--dry-run\t\tCompute and display upgrade path without executing. Implies -y."
    echo -e "--no-step-limit\t\tDisable the 3-step safety limit for -y mode. Requires CI=true."
    echo -e "--target-url=http\tPerform a simple connection test for your GitLab server."
    echo -e "--skip-lfs\t\tSkip LFS objects during backup (passes SKIP=lfs to gitlab-backup)."
    echo -e "--reset-stuck-finalizing\tReset batched_background_migrations rows stuck in status=finalizing(5) for >7 days back to active(1) so GitLab can re-finalize them. Does NOT execute the finalize rake task itself."
    echo -e "--max-tier=TIER\t\tUpper tier bound for the 'What is new since' link in the completion webhook. One of core/starter/premium/ultimate. Default: core for CE, ultimate for EE."
    echo -e "--discord-url=http\tNotify via Discord webhook."

    echo -e '\n\e[0;1mENV VALUES\e[m'
    echo -e "TARGET_URL=http\t\tSame as --target-url flag."
    echo -e "DISCORD_URL=http\tSame as --discord-url flag."
    echo -e "UPGRADE_GITLAB_CONFIG_HOOK=PATH\tExecutable run after gitlab.rb / gitlab-secrets.json copies are created and pruned. If unset, an executable file named 'upload-config.hook' next to this script is auto-detected. Receives env vars UPGRADE_GITLAB_BACKUP_DIR (container-side path; use 'docker cp' to extract), UPGRADE_GITLAB_VERSION, UPGRADE_GITLAB_CONTAINER, UPGRADE_GITLAB_SCRIPT_DIR. Hook failure logs a warning but does not abort the upgrade. See upload-config.hook.example."
    exit 0
else
    params=("${@}")
    for i in "${!params[@]}"; do
        if [[ "${params[$i]}" == "-"* ]]; then
            temp=$(echo "${params[$i]}" | awk -F '=' '{ print $2 }')

            if [ "${params[$i]}" == "-y" ] || [ "${params[$i]}" == "--yes" ]; then
                auto_yes=1
            elif [ "${params[$i]}" == "--dry-run" ]; then
                dry_run=1
                auto_yes=1
            elif [ "${params[$i]}" == "--no-step-limit" ]; then
                if [ "${CI:-}" != "true" ]; then
                    echo "Error: --no-step-limit is only allowed in CI environments (CI=true)." >&2
                    exit 1
                fi
                no_step_limit=1
            elif [ "${params[$i]}" == "--skip-latest" ] || [ "${params[$i]}" == "--n-1" ]; then
                if [ -n "$target_version_tag" ] && ! [[ "$target_version_tag" =~ ^[0-9]+$ ]]; then
                    echo "Error: --skip-latest can only be combined with major-only --version (e.g. --version=18)." >&2
                    exit 1
                fi
                skip_latest=1
            elif [ "${params[$i]}" == "--skip-lfs" ]; then
                skip_lfs=1
            elif [ "${params[$i]}" == "--reset-stuck-finalizing" ]; then
                reset_stuck_finalizing=1
            elif [[ "${params[$i]}" == "--max-tier"* ]]; then
                case "$temp" in
                    core|starter|premium|ultimate)
                        max_tier_flag=$temp
                        ;;
                    *)
                        echo "Error: --max-tier must be one of: core, starter, premium, ultimate" >&2
                        exit 1
                        ;;
                esac
            elif [[ "${params[$i]}" == "--source"* ]]; then
                echo "Error: --source flag has been removed. Upgrade path now uses path.json + Docker Hub automatically." >&2
                exit 1
            elif [[ "${params[$i]}" == "--edition"* ]]; then
                if [ "$temp" != "ce" ] && [ "$temp" != "ee" ]; then
                    echo "Error: --edition must be 'ce' or 'ee'" >&2
                    exit 1
                fi
                edition_flag=$temp
            elif [[ "${params[$i]}" == "--version"* ]]; then
                if [ $skip_latest -eq 1 ] && ! [[ "$temp" =~ ^[0-9]+$ ]]; then
                    echo "Error: --skip-latest can only be combined with major-only --version (e.g. --version=18)." >&2
                    exit 1
                fi
                if [ -n "$target_version_tag" ]; then
                    echo "Warning: Overriding target_version_tag from $target_version_tag to $temp"
                fi
                # Edition suffix will be applied after GITLAB_EDITION is determined
                target_version_tag=$temp
            elif [[ "${params[$i]}" == "--target-url"* ]]; then
                if [ -n "$TARGET_URL" ]; then
                    echo "Warning: Overriding TARGET_URL from $TARGET_URL to $temp"
                fi
                TARGET_URL=$temp
            elif [[ "${params[$i]}" == "--discord-url"* ]]; then
                if [ -n "$DISCORD_URL" ]; then
                    echo "Warning: Overriding DISCORD_URL from $DISCORD_URL to $temp"
                fi
                DISCORD_URL=$temp
            fi
        fi
    done
fi

# --------------------------
# 대화형 모드 TTY 검증
# --------------------------
if [ $auto_yes -eq 0 ] && [ ! -t 0 ]; then
    echo "Error: stdin is not a terminal. Use -y/--yes for non-interactive mode." >&2
    exit 1
fi

# --------------------------
# 필수 유틸리티 사전 검증
# --------------------------
for util in curl jq; do
    if ! which "$util" &> /dev/null; then
        echo "Error: Required utility '$util' is not installed. $(uname -a)" >&2
        if [ -d /usr/syno ]; then
            echo "Hint: On Synology DSM, install '$util' via Entware or opkg." >&2
        fi
        exit 1
    fi
done

if ! echo -e "1.10.0\n1.2.0" | sort -V &> /dev/null; then
    echo "Error: 'sort' does not support version sorting (-V). GNU coreutils is required." >&2
    exit 1
fi

if [ "${BASH_VERSION%%.*}" -lt 4 ] 2>/dev/null; then
    echo "Error: Bash 4.0+ is required (current: $BASH_VERSION)." >&2
    exit 1
fi

if ! which docker &> /dev/null; then
    echo "Docker is not installed on this system. $(uname -a)" >&2
    if [ -d /usr/syno ]; then
        echo 'Please install Docker (Obsolete) or ContainerManager before running this script.' >&2
        echo -e '\nRef:\n\thttps://www.synology.com/dsm/feature/container-manager' >&2
    else
        echo 'Please install DockerEngine or DockerDesktop before running this script.' >&2
        echo -e '\nRef:\n\thttps://docs.docker.com/engine/install\n\thttps://docs.docker.com/desktop' >&2
    fi
    exit 1
fi

if ! id | grep docker &> /dev/null && [ $UID -ne 0 ]; then
    echo "The $USER user does not have enough docker.sock permissions." >&2
    exit 1
fi

# --------------------------
# 🔍 gitlab/gitlab-ce 또는 gitlab/gitlab-ee 컨테이너 자동 감지
# --------------------------
CONTAINER_CANDIDATES=$(docker ps -a --format "{{.Image}}\t{{.Names}}" | grep "^gitlab/gitlab-\(ce\|ee\)" | awk '{print $2}')

# 이름으로 못 찾으면 이미지 ID → RepoTags 역조회로 재시도
if [ -z "$CONTAINER_CANDIDATES" ]; then
    while IFS=$'\t' read -r img name; do
        repo_tags=$(docker image inspect "$img" --format='{{range .RepoTags}}{{.}} {{end}}' 2>/dev/null)
        if echo "$repo_tags" | grep -q "gitlab/gitlab-\(ce\|ee\)"; then
            CONTAINER_CANDIDATES="${CONTAINER_CANDIDATES:+$CONTAINER_CANDIDATES$'\n'}$name"
        fi
    done < <(docker ps -a --format "{{.Image}}\t{{.Names}}")
fi

CONTAINER_COUNT=$(echo "$CONTAINER_CANDIDATES" | grep -c .)

if [ "$CONTAINER_COUNT" -eq 0 ]; then
    echo 'Error: No container using gitlab/gitlab-ce or gitlab/gitlab-ee image found.' >&2
    exit 1
elif [ "$CONTAINER_COUNT" -gt 1 ]; then
    echo 'Error: Multiple GitLab containers found:' >&2
    echo "  - ${CONTAINER_CANDIDATES//$'\n'/$'\n'  - }" >&2
    echo 'Please keep only one container running or specify which one to upgrade.' >&2
    exit 1
fi

CONTAINER_NAME=$CONTAINER_CANDIDATES
echo "Detected gitlab container: $CONTAINER_NAME"

# --------------------------
# 에디션 자동 감지 (CE/EE)
# --------------------------
CONFIG_IMAGE=$(docker inspect "$CONTAINER_NAME" --format='{{.Config.Image}}')
if ! echo "$CONFIG_IMAGE" | grep -q "^gitlab/gitlab-"; then
    CONFIG_IMAGE=$(docker image inspect "$CONFIG_IMAGE" --format='{{range .RepoTags}}{{.}} {{end}}' 2>/dev/null \
        | grep -oE "gitlab/gitlab-(ce|ee)[^ ]*" | head -1)
    if [ -z "$CONFIG_IMAGE" ]; then
        echo "Error: Cannot determine GitLab edition from container image." >&2
        echo "Hint: Try running 'docker tag <IMAGE_ID> gitlab/gitlab-ce:<VERSION>' to restore the image tag." >&2
        exit 1
    fi
fi
DETECTED_EDITION=$(echo "$CONFIG_IMAGE" | sed 's|gitlab/gitlab-||;s|:.*||')

if [ -n "$edition_flag" ]; then
    if [ "$DETECTED_EDITION" == "ee" ] && [ "$edition_flag" == "ce" ]; then
        echo "Error: Downgrading from EE to CE is not supported due to data loss risk." >&2
        exit 1
    fi
    if [ "$DETECTED_EDITION" != "$edition_flag" ]; then
        echo "Edition switch requested: $DETECTED_EDITION -> $edition_flag"
    fi
    GITLAB_EDITION=$edition_flag
else
    GITLAB_EDITION=$DETECTED_EDITION
    if [ "$GITLAB_EDITION" == "ce" ] && [ $auto_yes -eq 0 ]; then
        echo -en "Detected edition: CE. Would you like to switch to EE? (y/N) > "
        read -r switch_ee < "$_tty"
        if [ "$switch_ee" == "y" ] || [ "$switch_ee" == "Y" ]; then
            GITLAB_EDITION="ee"
            echo "Edition switch requested: ce -> ee"
        fi
    fi
fi

echo "Using GitLab edition: $GITLAB_EDITION"

GITLAB_IMAGE="gitlab/gitlab-${GITLAB_EDITION}"
TAG_SUFFIX="-${GITLAB_EDITION}.0"

# --version 플래그의 에디션 suffix 적용 (GITLAB_EDITION 확정 후)
_partial_version=0
if [ -n "$target_version_tag" ]; then
    # partial version 감지 (x 또는 x.y 형식)
    if [[ "$target_version_tag" =~ ^[0-9]+$ ]] || [[ "$target_version_tag" =~ ^[0-9]+\.[0-9]+$ ]]; then
        _partial_version=1
        echo "Partial version provided: $target_version_tag (will resolve after fetching tags)"
    else
        if [ "$(echo "$target_version_tag" | grep -c "\-${GITLAB_EDITION}")" -ne 1 ]; then
            target_version_tag="${target_version_tag}${TAG_SUFFIX}"
        fi

        if curl -sf "https://hub.docker.com/v2/repositories/${GITLAB_IMAGE}/tags/$target_version_tag" &> /dev/null; then
            echo "Using $target_version_tag instead of latest"
        else
            echo "Error: No such $target_version_tag tag in Docker Hub. Using alternative tag: latest" >&2
            target_version_tag=
        fi
    fi
fi

# --------------------------
# 1️⃣ 볼륨 마운트 추출
# --------------------------
VOLUMES=$(docker inspect "$CONTAINER_NAME" --format='{{range .Mounts}}{{.Source}}:{{.Destination}} {{end}}' \
    | tr ' ' '\n' \
    | sed '/^$/d' \
    | awk '{printf "-v %s ", $0}' \
    | sed 's/ $//')

# --------------------------
# 2️⃣ 포트 매핑 추출
# --------------------------
PORTS=$(docker inspect "$CONTAINER_NAME" --format='{{range $p, $conf := .HostConfig.PortBindings}}{{if $conf}}{{$p}}:{{(index $conf 0).HostPort}} {{end}}{{end}}' \
    | tr ' ' '\n' \
    | sed '/^$/d' \
    | sed 's/\/tcp//g' \
    | awk -F: '{printf "-p %s:%s ", $2, $1}')

send_discord_webhook() {
    if [ -z "$DISCORD_URL" ] || [ $# -ne 3 ]; then
        return 1
    fi

    format_title=
    hex_color=
    if [ "$1" == "ERR" ]; then
        hex_color=15158332 #빨강
        format_title="🛑 $2"
    elif [ "$1" == "WARN" ]; then
        hex_color=15904252 #주황
        format_title="⚠️ $2"
    elif [ "$1" == "NOTE" ]; then
        hex_color=3447003  #파랑
        format_title="🔔 $2"
    elif [ "$1" == "INFO" ]; then
        format_title="ℹ️ $2"
        hex_color=3066993  #초록
    else
        return 1
    fi

    JSON_PAYLOAD=$(jq -n \
        --arg title "$format_title" \
        --arg description "$3" \
        --argjson color "$hex_color" \
        '{
            "embeds": [{
                "title": $title,
                "color": $color,
                "fields": [
                    {"name": "Description", "value": $description, "inline": false}
                ],
                "footer": {"text": "GitLab upgrade helper"},
                "timestamp": (now | todate)
            }]
        }'
    )
    curl -s -H "Content-Type: application/json" \
        -X POST \
        -d "$JSON_PAYLOAD" \
        "$DISCORD_URL" &> /dev/null
}

_check_volume_space() {
    local volume_path=$1 label=$2
    local used_kb avail_kb required_kb

    used_kb=$(du -sk "$volume_path" 2>/dev/null | awk '{print $1}')
    avail_kb=$(df -k "$volume_path" 2>/dev/null | tail -1 | awk '{print $4}')

    if [ -z "$used_kb" ] || [ -z "$avail_kb" ]; then
        echo "  Warning: Could not determine $label volume space. Skipping." >&2
        return 0
    fi

    required_kb=$(( used_kb * 3 / 2 ))
    local used_gb=$(( used_kb / 1048576 ))
    local avail_gb=$(( avail_kb / 1048576 ))
    local required_gb=$(( required_kb / 1048576 ))

    echo "  $label volume: data=${used_gb}GB, available=${avail_gb}GB, recommended=${required_gb}GB (1.5x)"

    if [ "$avail_kb" -lt "$required_kb" ]; then
        echo "  WARNING: Insufficient $label disk space! ($volume_path)" >&2
        return 1
    fi
    return 0
}

check_disk_space() {
    local data_volume
    data_volume=$(docker inspect "$CONTAINER_NAME" \
        --format='{{range .Mounts}}{{.Source}}:{{.Destination}} {{end}}' \
        | tr ' ' '\n' | grep '/var/opt/gitlab' | awk -F: '{print $1}')

    local backup_path
    backup_path=$(docker exec "$CONTAINER_NAME" grep "'backup_path'" /etc/gitlab/gitlab.rb 2>/dev/null \
        | awk -F"=" '{ print $2 }' | sed 's/"//g' | sed 's/^ //')

    local backup_volume=""
    if [ -n "$backup_path" ]; then
        backup_volume=$(docker inspect "$CONTAINER_NAME" \
            --format='{{range .Mounts}}{{.Source}}:{{.Destination}} {{end}}' \
            | tr ' ' '\n' | while read -r mount; do
                local dest="${mount#*:}"
                local src="${mount%%:*}"
                if [[ "$backup_path" == "$dest"* ]]; then
                    echo "${src}${backup_path#"$dest"}"
                    break
                fi
            done)
    fi

    if [ -z "$data_volume" ]; then
        echo "Warning: Could not detect GitLab data volume path. Skipping disk space check." >&2
        return 0
    fi

    local insufficient=0

    _check_volume_space "$data_volume" "Data" || insufficient=1

    if [ -n "$backup_volume" ]; then
        local data_dev backup_dev
        data_dev=$(df "$data_volume" 2>/dev/null | tail -1 | awk '{print $1}')
        backup_dev=$(df "$backup_volume" 2>/dev/null | tail -1 | awk '{print $1}')
        if [ "$data_dev" != "$backup_dev" ]; then
            _check_volume_space "$backup_volume" "Backup" || insufficient=1
        else
            echo "  Note: Backup path is on the same device as data volume."
        fi
    fi

    if [ "$insufficient" -eq 1 ]; then
        send_discord_webhook "WARN" "Low disk space detected" "Review disk space before upgrading"
        if [ $auto_yes -eq 1 ]; then
            echo "Aborted due to insufficient disk space (-y mode)." >&2
            exit 1
        fi
        echo -n "Continue anyway? (y/N) > "
        read -r disk_confirm < "$_tty"
        if [ "$disk_confirm" != "y" ] && [ "$disk_confirm" != "Y" ]; then
            echo "Aborted due to insufficient disk space." >&2
            exit 1
        fi
    fi
}

check_secrets_integrity() {
    local phase=$1
    echo "Verifying secrets integrity ($phase)..."
    # gitlab:doctor:secrets 는 GitLab 13.1 이상에서만 사용 가능.
    #
    # 주의: 이 task는 복호화 실패를 발견해도 예외/비-0 종료를 하지 않는다. 실패 건수를 로그로만
    # 남기고 항상 "Done!"을 찍으며 exit 0 한다 (lib/gitlab/doctor/secrets.rb 의 run!).
    # 따라서 비-0 종료(+ "Done!" 부재)는 "복호화 실패"가 아니라 "task가 부팅/연결 단계에서 죽어
    # 완주하지 못함"을 뜻한다(gitlab-ctl restart/pg-upgrade 직후 Rails/DB/Redis 미준비 등).
    # → 완주 여부는 (exit 0 || "Done!")로 판단해 미완주면 재시도하고,
    #   실제 무결성은 완주한 출력의 "Total: N row(s) affected" 값으로 판정한다.
    local output rc attempt=0 affected
    local max_attempts=4
    local retry_sleep=${_SECRETS_RETRY_SLEEP:-15}
    while :; do
        output=$(run_with_bouncing_bar "Secrets Check" docker exec "$CONTAINER_NAME" gitlab-rake gitlab:doctor:secrets 2>&1)
        rc=$?

        if echo "$output" | grep -q "Don't know how to build task"; then
            echo "Skipping secrets integrity check ($phase): task not available in this version" >&2
            return 0
        fi

        # task가 완주했는가? (정상 종료 또는 "Done!" 출력)
        if [ "$rc" -eq 0 ] || echo "$output" | grep -q "Done!"; then
            affected=$(printf '%s\n' "$output" | sed -n 's/.*Total:[[:space:]]*\([0-9][0-9]*\)[[:space:]]*row(s) affected.*/\1/p' | tail -n1)
            if [ -n "$affected" ] && [ "$affected" -gt 0 ] 2>/dev/null; then
                echo "Warning: Secrets integrity check found ${affected} undecryptable row(s) ($phase). Please review manually." >&2
                echo "----- gitlab:doctor:secrets output (last 20 lines) -----" >&2
                printf '%s\n' "$output" | tail -n 20 >&2
                echo "-------------------------------------------------------" >&2
                send_discord_webhook "WARN" "Secrets check found ${affected} affected row(s) ($phase)" "Run gitlab-rake gitlab:doctor:secrets"
                return 1
            fi
            return 0
        fi

        # 완주 못 함 → restart 직후 일시 장애 가능성, 서비스 기동 시간을 두고 재시도
        attempt=$((attempt + 1))
        if [ "$attempt" -ge "$max_attempts" ]; then
            echo "Warning: secrets check could not complete after ${max_attempts} attempts ($phase); service may still be unavailable. Re-run 'gitlab-rake gitlab:doctor:secrets' manually." >&2
            echo "----- last attempt output (last 20 lines) -----" >&2
            printf '%s\n' "$output" | tail -n 20 >&2
            echo "-----------------------------------------------" >&2
            send_discord_webhook "WARN" "Secrets check did not complete ($phase)" "Run gitlab-rake gitlab:doctor:secrets"
            return 1
        fi
        echo "Secrets check did not complete (services may still be starting after restart); retrying in ${retry_sleep}s... (attempt ${attempt}/${max_attempts})" >&2
        sleep "$retry_sleep"
    done
}

_STUCK_THRESHOLD_DAYS=7

# 사람이 봐야 하는 치명적 상황을 강조하는 공통 배너 (status=4, -y에서의 status=5 stale)
_print_fatal_banner() {
    local title=$1
    local r='\e[0;1;31m' z='\e[m'
    {
        echo ''
        echo -e "${r}════════════════════════════════════════════════════════════════════${z}"
        echo -e "${r}  FATAL ERROR! MANUAL INTERVENTION REQUIRED${z}"
        echo -e "${r}  ${title}${z}"
        echo -e "${r}════════════════════════════════════════════════════════════════════${z}"
    } >&2
}

# stale 마이그레이션 한 행에 대한 사람용 정보/복구 가이드 출력
# args: id job_class table_name column_name job_arguments status age_sec
_print_stuck_row_info() {
    local id=$1 job=$2 tbl=$3 col=$4 jargs=$5 st=$6 age=$7
    local days=$((age / 86400))
    local hours=$(( (age % 86400) / 3600 ))
    local st_name='unknown'
    case "$st" in
        0) st_name='paused(0)' ;;
        1) st_name='active(1)' ;;
        2) st_name='aborted(2)' ;;
        4) st_name='failed(4)' ;;
        5) st_name='finalizing(5)' ;;
    esac
    {
        echo "  id=$id  job=$job"
        echo "  table=$tbl  column=$col  job_arguments=$jargs"
        echo "  status=$st_name  age=${days}d ${hours}h (>${_STUCK_THRESHOLD_DAYS}d threshold)"
    } >&2
}

# 수동 복구 가이드 (status=5 zombie 케이스)
_print_stuck_finalizing_guide() {
    local id=$1 job=$2 tbl=$3 col=$4 jargs=$5
    {
        echo ''
        echo "  The finalize process likely died without cleanup"
        echo "  (SIGKILL/OOM/host reboot during a previous reconfigure)."
        echo ''
        echo "  Manual recovery in another terminal:"
        echo "    1) Verify no Sidekiq worker is processing it:"
        echo "         docker exec $CONTAINER_NAME gitlab-rails runner \\"
        echo "           'puts Sidekiq::Workers.new.to_a.select { |_,_,w| w[\"payload\"][\"class\"] =~ /BackgroundMigration/ }.inspect'"
        echo "    2) Reset finalizing(5) -> active(1):"
        echo "         docker exec $CONTAINER_NAME gitlab-psql -c \\"
        echo "           \"UPDATE batched_background_migrations SET status=1 WHERE id=$id AND status=5;\""
        echo "    3) Manually finalize:"
        echo "         docker exec $CONTAINER_NAME gitlab-rake \\"
        echo "           \"gitlab:background_migrations:finalize[$job,$tbl,$col,'$jargs']\""
        echo ''
        echo "  Or re-run upgrade-gitlab with --reset-stuck-finalizing to auto-reset"
        echo "  status=5 rows. (Does NOT execute finalize itself; GitLab re-triggers"
        echo "  it on the next post-deploy migration.)"
        echo ''
    } >&2
}

# 수동 복구 가이드 (status=4 fatal 케이스)
_print_stuck_failed_guide() {
    local id=$1
    {
        echo ''
        echo "  The migration is in failed(4) state. This usually means individual"
        echo "  batch jobs hit hard errors and exhausted their retry budget."
        echo "  Auto-recovery is unsafe — investigate before proceeding."
        echo ''
        echo "  Manual investigation in another terminal:"
        echo "    1) Inspect failed jobs:"
        echo "         docker exec $CONTAINER_NAME gitlab-psql -c \\"
        echo "           \"SELECT id, attempts, exception_class, exception_message, min_value, max_value"
        echo "              FROM batched_background_migration_jobs"
        echo "             WHERE batched_background_migration_id=$id AND status=2 ORDER BY id;\""
        echo "    2) After fixing the root cause, split-and-retry failed jobs:"
        echo "         docker exec $CONTAINER_NAME gitlab-rails runner \\"
        echo "           'Gitlab::Database::BackgroundMigration::BatchedMigration.find($id).batched_jobs.failed.each(&:split_and_retry!)'"
        echo "    3) Re-run upgrade-gitlab once status returns to active(1) and progresses."
        echo ''
    } >&2
}

# stale 행을 한 번 조회. 결과는 stdout으로 (id|job|table|col|jargs|status|age_sec) 라인.
_query_stuck_migrations() {
    docker exec "$CONTAINER_NAME" gitlab-psql -tAc "
        SELECT id || '|' ||
               COALESCE(job_class_name, '') || '|' ||
               COALESCE(table_name, '') || '|' ||
               COALESCE(column_name, '') || '|' ||
               COALESCE(job_arguments::text, '[]') || '|' ||
               status || '|' ||
               EXTRACT(EPOCH FROM (NOW() - updated_at))::bigint
        FROM batched_background_migrations
        WHERE status NOT IN (3, 6)
          AND updated_at < NOW() - INTERVAL '${_STUCK_THRESHOLD_DAYS} days'
        ORDER BY id;
    " 2>/dev/null
}

# stale 마이그레이션 검사 + 처리.
# 반환:
#   0 = 진행 가능 (stale 없음 / auto-reset 완료 / 인터랙티브 대기 후 해소)
#   exit 1 = 치명적 (status=4 또는 -y에서의 status=5)
_check_stuck_migrations() {
    local rows
    rows=$(_query_stuck_migrations)
    if [ -z "$rows" ]; then
        return 0
    fi

    local has_failed=0 has_finalizing=0
    local fatal_failed_lines='' fatal_finalizing_lines=''
    local id job tbl col jargs st age

    while IFS='|' read -r id job tbl col jargs st age; do
        [ -z "$id" ] && continue
        case "$st" in
            4)
                has_failed=1
                fatal_failed_lines+="$id|$job|$tbl|$col|$jargs|$st|$age"$'\n'
                ;;
            5)
                has_finalizing=1
                fatal_finalizing_lines+="$id|$job|$tbl|$col|$jargs|$st|$age"$'\n'
                ;;
            *)
                # 진행 중일 가능성이 있어 경고만 출력 (false positive 방지)
                {
                    echo ''
                    echo "[warning] batched_background_migration appears stale but is not finalized:"
                    _print_stuck_row_info "$id" "$job" "$tbl" "$col" "$jargs" "$st" "$age"
                    echo "  This may be a legitimately slow active migration. No action taken."
                } >&2
                ;;
        esac
    done <<< "$rows"

    # 1) status=4 (failed) — 항상 FATAL
    if [ "$has_failed" -eq 1 ]; then
        _print_fatal_banner "Background migration in failed(4) state"
        while IFS='|' read -r id job tbl col jargs st age; do
            [ -z "$id" ] && continue
            _print_stuck_row_info "$id" "$job" "$tbl" "$col" "$jargs" "$st" "$age"
            _print_stuck_failed_guide "$id"
        done <<< "$fatal_failed_lines"
        send_discord_webhook "ERR" "Background migration failed" "Stuck in failed(4) state — manual intervention required"
        exit 1
    fi

    # 2) status=5 (finalizing) — 옵션/모드에 따라 분기
    if [ "$has_finalizing" -eq 1 ]; then
        if [ "$reset_stuck_finalizing" -eq 1 ]; then
            echo '' >&2
            echo "Auto-resetting stuck finalizing(5) rows -> active(1) (--reset-stuck-finalizing):" >&2
            while IFS='|' read -r id job tbl col jargs st age; do
                [ -z "$id" ] && continue
                _print_stuck_row_info "$id" "$job" "$tbl" "$col" "$jargs" "$st" "$age"
                if docker exec "$CONTAINER_NAME" gitlab-psql -c \
                    "UPDATE batched_background_migrations SET status=1 WHERE id=$id AND status=5;" >/dev/null 2>&1; then
                    echo "  -> reset to active(1). GitLab will re-trigger finalize on the next post-deploy migration." >&2
                else
                    echo "  -> reset FAILED. Manual intervention required." >&2
                    exit 1
                fi
            done <<< "$fatal_finalizing_lines"
            send_discord_webhook "WARN" "Auto-reset stuck finalizing migrations" "Reset to active(1); GitLab will re-finalize."
            return 0
        fi

        if [ "$auto_yes" -eq 1 ]; then
            # 비인터랙티브: FATAL exit
            _print_fatal_banner "Background migration stuck in finalizing(5) state"
            while IFS='|' read -r id job tbl col jargs st age; do
                [ -z "$id" ] && continue
                _print_stuck_row_info "$id" "$job" "$tbl" "$col" "$jargs" "$st" "$age"
                _print_stuck_finalizing_guide "$id" "$job" "$tbl" "$col" "$jargs"
            done <<< "$fatal_finalizing_lines"
            send_discord_webhook "ERR" "Background migration stuck (finalizing)" "Stuck in finalizing(5) — manual intervention required"
            exit 1
        fi

        # 인터랙티브: 가이드 출력 후 다른 터미널에서 해결될 때까지 폴링 대기
        echo '' >&2
        echo "[!] Stuck batched_background_migration detected (finalizing(5))" >&2
        while IFS='|' read -r id job tbl col jargs st age; do
            [ -z "$id" ] && continue
            _print_stuck_row_info "$id" "$job" "$tbl" "$col" "$jargs" "$st" "$age"
            _print_stuck_finalizing_guide "$id" "$job" "$tbl" "$col" "$jargs"
        done <<< "$fatal_finalizing_lines"
        send_discord_webhook "WARN" "Background migration stuck (finalizing)" "Waiting for manual recovery in another terminal..."
        echo "Waiting for manual recovery in another terminal. Polling every 30s. (Ctrl+C to abort.)" >&2

        local poll_spinner='/-\|' poll_idx=0
        while true; do
            for ((s=0; s<30; s++)); do
                if [ -e /dev/tty ]; then
                    printf '\r  waiting... %s' "${poll_spinner:poll_idx++%${#poll_spinner}:1}" >&2
                fi
                sleep 1
            done
            local recheck
            recheck=$(_query_stuck_migrations)
            # finalizing(5) 행이 사라졌는지 확인 (다른 stale은 다음 iteration에서 다시 분기)
            if ! echo "$recheck" | grep -q '|5|'; then
                if [ -e /dev/tty ]; then
                    printf '\r\033[K' >&2
                fi
                echo "Stuck finalizing rows resolved. Resuming." >&2
                send_discord_webhook "NOTE" "Stuck migration resolved" "Resuming upgrade flow."
                return 0
            fi
        done
    fi

    # status=0/1/2 stale만 있는 경우는 경고만 하고 진행
    return 0
}

wait_for_background_migrations() {
    # batched_background_migrations 테이블은 GitLab 13.10 이상에서만 존재.
    # 단, 쿼리 자체가 실패(컨테이너 start/swap 직후 PostgreSQL이 아직 연결을 받지 못하거나
    # pg-upgrade로 PG가 잠시 내려간 상태 등)하면 빈 값이 돌아오는데, 이를 "테이블 없음(구버전)"과
    # 혼동해 검사를 통째로 스킵하면 안 된다. psql이 성공적으로 t/f를 돌려줄 때까지 짧게 재시도하고,
    # 명시적으로 f(=테이블 없음)일 때만 스킵한다.
    local table_exists rc attempt=0
    while :; do
        table_exists=$(docker exec "$CONTAINER_NAME" gitlab-psql -tAc \
            "SELECT EXISTS (SELECT FROM information_schema.tables WHERE table_name = 'batched_background_migrations');" \
            2>/dev/null)
        rc=$?
        table_exists=${table_exists//[[:space:]]/}
        if [ "$rc" -eq 0 ] && { [ "$table_exists" = "t" ] || [ "$table_exists" = "f" ]; }; then
            break
        fi
        attempt=$((attempt + 1))
        if [ "$attempt" -ge 45 ]; then
            echo "Warning: batched_background_migrations table query did not succeed after ${attempt} attempts (database not reachable?). Skipping background migration check." >&2
            return 0
        fi
        sleep 2
    done

    if [ "$table_exists" = "f" ]; then
        echo "Skipping background migration check: batched_background_migrations table not present (GitLab < 13.10)"
        return 0
    fi

    # stuck 감지: status=4(failed), status=5(finalizing) zombie, 기타 stale
    _check_stuck_migrations

    echo "Waiting for background migrations to complete..."
    local spinner='/-\|'
    local spin_idx=0
    local prev_lines=0

    while true; do
        # 개별 마이그레이션: name|completed_jobs|total_jobs
        PROGRESS=$(docker exec "$CONTAINER_NAME" gitlab-psql -tAc "
            SELECT m.job_class_name || '|' ||
                (SELECT COUNT(*) FROM batched_background_migration_jobs j
                 WHERE j.batched_background_migration_id = m.id AND j.status = 3) || '|' ||
                (SELECT COUNT(*) FROM batched_background_migration_jobs j
                 WHERE j.batched_background_migration_id = m.id)
            FROM batched_background_migrations m
            WHERE m.status NOT IN (3, 6)
            ORDER BY m.id;
        " 2>/dev/null)

        # 이전 출력 지우기
        if [ "$prev_lines" -gt 1 ]; then
            printf '\033[%dA' "$((prev_lines - 1))"
        fi
        if [ "$prev_lines" -gt 0 ]; then
            printf '\r\033[J'
        fi

        if [ -z "$PROGRESS" ]; then
            REMAINING=$(docker exec "$CONTAINER_NAME" gitlab-psql -tAc \
                "SELECT COUNT(*) FROM batched_background_migrations WHERE status NOT IN (3, 6);" \
                2>/dev/null | tr -d '[:space:]')
            if [[ "$REMAINING" =~ ^[0-9]+$ ]] && [ "$REMAINING" -eq 0 ]; then
                echo "Background migrations: all completed"
                break
            fi
            if [ -e /dev/tty ]; then
                printf "Background migrations: waiting for response... %s" "${spinner:spin_idx++%${#spinner}:1}"
                prev_lines=1
                for ((s=0; s<5; s++)); do
                    sleep 1
                    printf '\r'"Background migrations: waiting for response... %s" "${spinner:spin_idx++%${#spinner}:1}"
                done
            else
                echo "Background migrations: waiting for response..."
                sleep 5
            fi
            continue
        fi

        local active_count all_done=true interval
        active_count=$(echo "$PROGRESS" | wc -l)

        if [ -e /dev/tty ]; then
            printf "Background migrations: [%d active] %s" "$active_count" "${spinner:spin_idx++%${#spinner}:1}"
            prev_lines=1

            while IFS='|' read -r name completed total; do
                if [ -z "$total" ] || [ "$total" -eq 0 ] 2>/dev/null; then
                    printf "\n  %s: Pending" "$name"
                    all_done=false
                else
                    local pct=$((completed * 100 / total))
                    printf "\n  %s: %d%% (%d/%d)" "$name" "$pct" "$completed" "$total"
                    if [ "$completed" -ne "$total" ]; then
                        all_done=false
                    fi
                fi
                prev_lines=$((prev_lines + 1))
            done <<< "$PROGRESS"

            if [ "$all_done" = true ]; then interval=5; else interval=15; fi
            for ((s=0; s<interval; s++)); do
                sleep 1
                if [ "$prev_lines" -gt 1 ]; then
                    printf '\033[%dA' "$((prev_lines - 1))"
                fi
                printf '\r'"Background migrations: [%d active] %s" "$active_count" "${spinner:spin_idx++%${#spinner}:1}"
                if [ "$prev_lines" -gt 1 ]; then
                    printf '\033[%dB' "$((prev_lines - 1))"
                fi
            done
        else
            # CI/non-TTY: 스피너 없이 상태 한 줄 출력 후 대기
            local summary="Background migrations: [${active_count} active]"
            while IFS='|' read -r name completed total; do
                if [ -z "$total" ] || [ "$total" -eq 0 ] 2>/dev/null; then
                    all_done=false
                elif [ "$completed" -ne "$total" ]; then
                    all_done=false
                fi
            done <<< "$PROGRESS"
            echo "$summary"
            if [ "$all_done" = true ]; then interval=5; else interval=15; fi
            sleep "$interval"
        fi
    done
}

check_migration_status() {
    # db:migrate:status 도 restart/swap 직후엔 일시적으로 실패해 빈 출력을 낼 수 있다.
    # 빈 출력을 "down 0건"으로 오인하면 실제 문제를 놓치므로(=false negative), 상태 테이블
    # (up/down 행)이 실제로 나올 때까지 짧게 재시도한 뒤 down 개수를 센다.
    local migrate_output attempt=0
    local max_attempts=4
    local retry_sleep=${_MIGRATE_STATUS_RETRY_SLEEP:-15}
    while :; do
        migrate_output=$(run_with_bouncing_bar "Migration Status" docker exec "$CONTAINER_NAME" gitlab-rake db:migrate:status 2>/dev/null)
        if printf '%s\n' "$migrate_output" | grep -qE '^[[:space:]]*(up|down)[[:space:]]'; then
            break
        fi
        attempt=$((attempt + 1))
        if [ "$attempt" -ge "$max_attempts" ]; then
            echo "Warning: could not read migration status after ${max_attempts} attempts (service may still be starting). Re-run 'gitlab-rake db:migrate:status' manually." >&2
            send_discord_webhook "WARN" "Migration status unavailable" "Could not read db:migrate:status after upgrade"
            return 0
        fi
        echo "Migration status not available yet (service may still be starting); retrying in ${retry_sleep}s... (attempt ${attempt}/${max_attempts})" >&2
        sleep "$retry_sleep"
    done

    local down_count
    down_count=$(printf '%s\n' "$migrate_output" | grep -c "^[[:space:]]*down")
    if [ "$down_count" -gt 0 ]; then
        echo "Warning: $down_count migration(s) in 'down' state detected" >&2
        printf '%s\n' "$migrate_output" | grep "^[[:space:]]*down" >&2
        send_discord_webhook "WARN" "Migration status issue" "$down_count migration(s) in down state"
    fi
}

wait_for_http_ready() {
    local label=$1
    echo "waiting until $label server boots..."
    # shellcheck disable=SC2329
    if [ "${CI:-}" = "true" ]; then
        # CI/DinD: 컨테이너 내부에서 curl (네트워크 격리 및 IP 변경 문제 회피)
        _http_ready_check() {
            [ "$(docker exec "$CONTAINER_NAME" curl -sf -m 3 -o /dev/null "http://localhost/users/sign_in" -w "%{http_code}" 2>/dev/null)" = '200' ]
        }
    else
        _http_ready_check() {
            [ "$(curl -sf -m 3 -o /dev/null "$TARGET_URL/users/sign_in" -w "%{http_code}" 2>/dev/null)" = '200' ]
        }
    fi
    poll_with_bouncing_bar "HTTP Ready" _http_ready_check
    unset -f _http_ready_check
    echo 'done'
}

wait_for_healthy() {
    local label=$1
    echo "waiting until $label container is ready..."
    # shellcheck disable=SC2329
    _healthy_check() {
        [ "$(docker inspect --format='{{.State.Health.Status}}' "$CONTAINER_NAME" | grep -v unhealthy | grep -c healthy)" -eq 1 ]
    }
    poll_with_bouncing_bar "Health Check" _healthy_check
    unset -f _healthy_check
    echo 'done'
}

check_gitlab_server_healthy() {
    local skip_reconfigure=${1:-0}
    # caller (main flow / recovery branch)가 outer critical로 감싸고 있음.
    # gitlab-ctl status는 서비스가 다 뜨기 전엔 일시적으로 비-0일 수 있다. 컨테이너는 살아있는데
    # 한 번의 status 실패로 reconfigure/pg-upgrade/db:migrate를 통째로 건너뛰지 않도록 짧게 재시도하고,
    # 끝까지 실패할 때만 print_stacktrace_errors(컨테이너가 실제로 죽었으면 exit 1)로 넘긴다.
    local attempt=0 max_attempts=5
    local retry_sleep=${_HEALTH_STATUS_RETRY_SLEEP:-15}
    while ! docker exec "$CONTAINER_NAME" gitlab-ctl status > /dev/null 2>&1; do
        attempt=$((attempt + 1))
        if [ "$attempt" -ge "$max_attempts" ]; then
            print_stacktrace_errors
            return
        fi
        echo "gitlab-ctl status not ready yet (services may still be starting); retrying in ${retry_sleep}s... (attempt ${attempt}/${max_attempts})" >&2
        sleep "$retry_sleep"
    done

    if [ "$skip_reconfigure" -eq 0 ]; then
        run_with_bouncing_bar "Reconfigure" docker exec "$CONTAINER_NAME" gitlab-ctl reconfigure
    else
        run_with_bouncing_bar "Restart" docker exec "$CONTAINER_NAME" gitlab-ctl restart
    fi
    run_with_bouncing_bar "PG Upgrade" docker exec "$CONTAINER_NAME" gitlab-ctl pg-upgrade
    run_with_bouncing_bar "DB Migrate" docker exec "$CONTAINER_NAME" gitlab-rake db:migrate
    run_with_bouncing_bar "Status" docker exec "$CONTAINER_NAME" gitlab-ctl status || print_stacktrace_errors
}

print_stacktrace_errors() {
    if [ $_in_stacktrace -eq 1 ]; then
        return 0
    fi
    if [ "$(docker inspect --format='{{.State.ExitCode}}' "$CONTAINER_NAME")" -ne 0 ]; then
        _in_stacktrace=1
        echo -e "\nError: gitlab container died with the following status code: $(docker inspect --format='{{.State.ExitCode}}' "$CONTAINER_NAME")" >&2

        local logs
        logs=$(docker logs --tail 200 "$CONTAINER_NAME" 2>&1)
        echo "$logs" >&2
        echo -e '\e[1;5;37;41mFATAL ERROR: MANUAL INTERVENTION IS REQUIRED\e[0m' >&2

        if echo "$logs" | grep -q "Removed configurations found in gitlab.rb"; then
            # 메이저 업그레이드에서 제거된 설정 키 때문에 reconfigure가 중단된 경우.
            # 백업 복원이 아니라 해당 키를 제거하고 재실행하는 것이 정답이다. GitLab 19.0의 번들
            # Mattermost 제거가 대표 사례인데, 트리거는 보통 gitlab.rb가 아니라 gitlab-secrets.json에
            # 자동 생성된 mattermost 섹션이다(미사용 stock 설치도 영향받음).
            echo 'Reconfigure aborted: configuration keys removed in this GitLab version are still present.' >&2
            echo 'This is NOT fixed by restoring a backup. For GitLab 19.0 (bundled Mattermost removed):' >&2
            echo '  1) remove the "mattermost" section from /etc/gitlab/gitlab-secrets.json' >&2
            echo '     (it is auto-generated even if you never used bundled Mattermost),' >&2
            echo '  2) delete any mattermost[...] lines from gitlab.rb,' >&2
            echo '  then re-run this script. If you DID use bundled Mattermost, migrate it to a standalone' >&2
            echo '  server first: https://docs.gitlab.com/integration/mattermost/' >&2
            send_discord_webhook "ERR" "Reconfigure aborted: removed config keys" "Remove the 'mattermost' section from gitlab-secrets.json (and mattermost[...] from gitlab.rb), then re-run."
        else
            # shellcheck disable=SC2016
            echo 'upgrade-gitlab script does not recover this issue. Please restore previous backup with `gitlab-rake gitlab:backup:restore`' >&2
            echo 'For more information, please visit: https://docs.gitlab.com/administration/backup_restore' >&2
            send_discord_webhook "ERR" "FATAL ERROR occurred!" "See: https://docs.gitlab.com/administration/backup_restore"
        fi
        echo 'Troubleshooting guide: https://gitlab.com/gitlab-useful-scripts/upgrade-gitlab/-/wikis/Troubleshooting' >&2
        if [ -z "$BACKUP_DIR" ]; then
            BACKUP_DIR=$(docker exec "$CONTAINER_NAME" grep "'backup_path'" /etc/gitlab/gitlab.rb 2>/dev/null | awk -F"=" '{ print $2 }' | sed 's/\"//g' | sed 's/^ //')
        fi
        echo "backup_path: $BACKUP_DIR" >&2
        exit 1
    fi
}

_prev_exit=$(docker inspect --format='{{.State.ExitCode}}' "$CONTAINER_NAME" 2>/dev/null || echo 0)

if ! docker ps --format "{{.Names}}" | grep -q "^$CONTAINER_NAME$"; then
    docker start "$CONTAINER_NAME" &> /dev/null
    wait_for_healthy "GitLab server"
fi

CURRENT_VERSION=$(docker exec "$CONTAINER_NAME" dpkg -l 2>/dev/null | awk '/^ii/ && $2 ~ /^gitlab-(ce|ee)$/ { print $3 }' | head -n1)
if [ -z "$CURRENT_VERSION" ]; then
    echo "Error: could not determine current GitLab version (dpkg query failed or gitlab-ce/gitlab-ee package not found in container)." >&2
    exit 1
fi

start_time=$SECONDS

# --- Backup progress helpers ---
_backup_stats_available=0
_total_lfs_size=0
_total_artifacts_size=0
_total_uploads_size=0
_total_project_count=0
_size_poller_pid=
_size_poller_file=

_query_backup_stats() {
    local raw
    raw=$(docker exec "$CONTAINER_NAME" gitlab-psql -tAc \
        "SELECT COALESCE(SUM(repository_size),0)||'|'||COALESCE(SUM(lfs_objects_size),0)||'|'||COALESCE(SUM(build_artifacts_size),0)||'|'||COALESCE(SUM(uploads_size),0)||'|'||COUNT(*) FROM project_statistics;" 2>/dev/null) || {
        _backup_stats_available=0
        return
    }
    if [ -z "$raw" ] || ! echo "$raw" | grep -qE '^[0-9]+\|'; then
        _backup_stats_available=0
        return
    fi
    IFS='|' read -r _ _total_lfs_size _total_artifacts_size _total_uploads_size _total_project_count <<< "$raw"
    _backup_stats_available=1
}

# _draw_backup_progress <label> <percentage> <tick> [approx] [extra]
# Renders: [label] [###############·····························] 52% ETA 00:12:34
# Label has a shimmer effect: a bright highlight wave scrolls left-to-right
# <extra> (optional) is appended verbatim after the percentage (ETA text).
_draw_backup_progress() {
    local label=$1
    local pct=$2
    local tick=$3
    local approx=${4:-0}
    local extra=${5:-}
    local cols=${COLUMNS:-$(tput cols 2>/dev/null || stty size 2>/dev/null | awk '{print $2}' || echo 80)}
    local reset='\033[0m'

    # Cap percentage at 100
    if [ "$pct" -gt 100 ]; then
        pct=100
    fi

    local suffix
    if [ "$approx" -eq 1 ]; then
        suffix=$(printf " ~%d%%" "$pct")
    else
        suffix=$(printf " %d%%" "$pct")
    fi
    suffix+="$extra"
    # overhead: "[" label "]" " [" bar "]" suffix
    local overhead=$(( ${#label} + 5 + ${#suffix} ))
    local bar_length=$(( cols - overhead ))
    if [ "$bar_length" -lt 5 ]; then
        bar_length=5
    fi

    local filled=$(( pct * bar_length / 100 ))
    local empty=$(( bar_length - filled ))

    local bar_filled bar_empty
    bar_filled=$(printf '%*s' "$filled" '' | tr ' ' '#')
    # shellcheck disable=SC1003
    bar_empty=$(printf '%*s' "$empty" '' | sed 's/ /·/g')

    # Shimmer effect on label: a bright highlight sweeps left-to-right
    # Colors cycle through dark→bright→dark across the label text
    # Background: green (normal) or yellow (critical section)
    local bg=42
    if [ "${_trap_active:-0}" -eq 1 ]; then
        bg=43
    fi
    # Shimmer wave: highlight position moves with tick
    local label_len=${#label}
    local shimmer_width=4
    local shimmer_pos=$(( tick % (label_len + shimmer_width + shimmer_width) - shimmer_width ))
    local shimmer_label=""
    local i ch dist
    for (( i=0; i<label_len; i++ )); do
        ch="${label:i:1}"
        dist=$(( i - shimmer_pos ))
        if [ "$dist" -lt 0 ]; then dist=$(( -dist )); fi
        if [ "$dist" -eq 0 ]; then
            # Bright white (peak of shimmer)
            shimmer_label+="\033[97;${bg}m${ch}"
        elif [ "$dist" -le 1 ]; then
            # Light green foreground
            shimmer_label+="\033[92;${bg}m${ch}"
        elif [ "$dist" -le 2 ]; then
            # Normal green foreground
            shimmer_label+="\033[32;${bg}m${ch}"
        else
            # Dark foreground (default for bg)
            shimmer_label+="\033[30;${bg}m${ch}"
        fi
    done

    printf '\r\033[K\033[%dm[%b]%b [%s%s]%s' "$bg" "$shimmer_label" "$reset" "$bar_filled" "$bar_empty" "$suffix" > "$_tty"
}

# _draw_bouncing_frame <label> <tick>
# Draws a single bouncing bar frame based on tick count (no persistent pos/direction state)
_draw_bouncing_frame() {
    local label=$1
    local tick=$2
    local cols=${COLUMNS:-$(tput cols 2>/dev/null || stty size 2>/dev/null | awk '{print $2}' || echo 80)}
    local bounce='#####'
    local bounce_len=${#bounce}
    local bar_width=$(( cols - ${#label} - 5 ))
    if [ "$bar_width" -lt 10 ]; then
        bar_width=10
    fi
    local reset='\033[0m'

    # Triangle wave position from tick
    local cycle=$(( 2 * (bar_width - bounce_len) ))
    if [ "$cycle" -le 0 ]; then cycle=1; fi
    local phase=$(( tick % cycle ))
    local pos
    if [ "$phase" -lt $(( bar_width - bounce_len )) ]; then
        pos=$phase
    else
        pos=$(( cycle - phase ))
    fi

    local bg_color='\033[42;30m'
    if [ "${_trap_active:-0}" -eq 1 ]; then
        bg_color='\033[43;30m'
    fi

    local padding_left padding_right bar_line
    padding_left=$(printf '%*s' "$pos" '')
    padding_right=$(printf '%*s' "$((bar_width - pos - bounce_len))" '')
    bar_line=$(printf "${bg_color}[%s]${reset} [%s%s%s]" "$label" "$padding_left" "$bounce" "$padding_right")
    printf '\r\033[K%s' "$bar_line" > "$_tty"
}

_start_size_poller() {
    _size_poller_file=$(mktemp)
    docker exec "$CONTAINER_NAME" sh -c '
        while true; do
            stat -c "%s %n" /var/opt/gitlab/backups/*.tar.gz 2>/dev/null
            stat -c "%s %n" /var/opt/gitlab/backups/*_gitlab_backup.tar 2>/dev/null
            sum=0
            for f in /sys/class/net/*/statistics/tx_bytes; do
                name=${f%/statistics/tx_bytes}; name=${name##*/}
                [ "$name" = "lo" ] && continue
                if [ -r "$f" ]; then
                    v=$(cat "$f" 2>/dev/null) || v=0
                    sum=$((sum + ${v:-0}))
                fi
            done
            echo "$sum tx_bytes_total"
            echo ---
            sleep 0.5
        done
    ' >> "$_size_poller_file" 2>/dev/null &
    _size_poller_pid=$!
}

_stop_size_poller() {
    if [ -n "${_size_poller_pid:-}" ]; then
        kill "$_size_poller_pid" 2>/dev/null
        wait "$_size_poller_pid" 2>/dev/null
        _size_poller_pid=
    fi
    if [ -n "${_size_poller_file:-}" ]; then
        rm -f "$_size_poller_file"
        _size_poller_file=
    fi
}

# _get_current_tar_size <filename>
# Prints the latest size (bytes) of the given tar.gz from the poller output
_get_current_tar_size() {
    local filename=$1
    if [ -z "${_size_poller_file:-}" ] || [ ! -f "$_size_poller_file" ]; then
        echo 0
        return
    fi
    local size
    size=$(grep "$filename" "$_size_poller_file" | tail -1 | awk '{print $1}')
    # Ensure integer (strip non-digits)
    size="${size//[!0-9]/}"
    echo "${size:-0}"
}

# Prints the latest container egress total (bytes) from the poller output.
_get_current_tx_bytes() {
    if [ -z "${_size_poller_file:-}" ] || [ ! -f "$_size_poller_file" ]; then
        echo 0
        return
    fi
    local v
    v=$(grep "tx_bytes_total" "$_size_poller_file" | tail -1 | awk '{print $1}')
    v="${v//[!0-9]/}"
    echo "${v:-0}"
}

draw_progress() {
    local current=$1
    local total=$2
    local prefix=$3
    local item_name=$4
    local cols=${COLUMNS:-$(tput cols 2>/dev/null || stty size 2>/dev/null | awk '{print $2}' || echo 80)}

    local progress=0
    if [ "$total" -gt 0 ]; then
        progress=$(( current * 100 / total ))
    fi

    local elapsed=$(( SECONDS - start_time ))

    local eta=0
    if [ "$current" -gt 0 ]; then
        eta=$(( elapsed * (total - current) / current ))
    fi

    local h=$(( eta / 3600 ))
    local m=$(( (eta % 3600) / 60 ))
    local s=$(( eta % 60 ))

    # 바 이외 고정 부분 길이 계산: "prefix: [>] 100% (item_name total/total) ETA 00:00:00"
    local suffix
    suffix=$(printf " %d%% (%s %d/%d) ETA %02d:%02d:%02d" "$progress" "$item_name" "$current" "$total" $h $m $s)
    local overhead=$(( ${#prefix} + 4 + ${#suffix} ))  # ": [" (3) + "]" (1) + prefix + suffix
    local bar_length=$(( cols - overhead ))
    if [ "$bar_length" -lt 5 ]; then
        bar_length=5
    fi

    local filled=$(( progress * bar_length / 100 ))
    local empty=$(( bar_length - filled ))

    local bar spaces line
    bar=$(printf '%*s' "$filled" '' | tr ' ' '#')
    # shellcheck disable=SC1003
    spaces=$(printf '%*s' "$empty" '' | sed 's/ /·/g')
    line=$(printf "%s: [%s%s]%s" "$prefix" "$bar" "$spaces" "$suffix")

    if [ -e /dev/tty ]; then
        printf "\r\033[K%s" "${line:0:cols}"
        if (( current == total )); then
            echo ""
        fi
    fi
}

# run_with_bouncing_bar <label> <command...>
# 명령을 실행하면서 하단에 바운싱 바 표시
# 명령의 stdout/stderr를 stdout으로 패스스루하되, 출력 없는 구간에 바운싱 바 애니메이션
# 바운싱 바 애니메이션은 /dev/tty로 직접 출력하여 stdout 캡처 시에도 터미널에 표시
run_with_bouncing_bar() {
    local label=$1
    shift
    local cmd=("$@")
    local tmpfile
    tmpfile=$(mktemp)
    local cols=${COLUMNS:-$(tput cols 2>/dev/null || stty size 2>/dev/null | awk '{print $2}' || echo 80)}
    local pos=0
    local direction=1
    local bounce='#####'
    local bounce_len=${#bounce}
    # bar_width = 터미널 너비 - "[label] [" (label+4) - "]" (1) 를 빼서 동적 계산
    local bar_width=$(( cols - ${#label} - 5 ))
    if [ "$bar_width" -lt 10 ]; then
        bar_width=10
    fi
    local reset='\033[0m'
    local bg_color current_lines last_output padding_left padding_right bar_line

    # 명령을 백그라운드로 실행, 출력을 임시 파일에 기록
    "${cmd[@]}" > "$tmpfile" 2>&1 &
    local cmd_pid=$!
    local last_line_count=0

    while kill -0 "$cmd_pid" 2>/dev/null; do
        # 새 출력 확인 및 표시
        current_lines=$(wc -l < "$tmpfile")
        if [ "$current_lines" -gt "$last_line_count" ]; then
            printf '\r\033[K' > "$_tty"
            sed -n "$((last_line_count + 1)),${current_lines}p" "$tmpfile"
            last_line_count=$current_lines
            # 마지막 출력에서 단계명 파싱
            last_output=$(tail -1 "$tmpfile" | sed -n 's/.*-- \(.*\) \.\.\..*/\1/p')
            if [ -n "$last_output" ]; then
                label="Backup: $last_output"
            fi
        fi

        # label 변경에 맞춰 bar_width 재계산
        bar_width=$(( cols - ${#label} - 5 ))
        if [ "$bar_width" -lt 10 ]; then
            bar_width=10
        fi
        if [ $pos -ge $((bar_width - bounce_len)) ]; then
            pos=$((bar_width - bounce_len - 1))
            direction=-1
        fi

        # 라벨 배경색: critical section(노랑), 일반(초록)
        bg_color='\033[42;30m'
        if [ "${_trap_active:-0}" -eq 1 ]; then
            bg_color='\033[43;30m'
        fi

        # 바운싱 바 그리기 (tty)
        padding_left=$(printf '%*s' "$pos" '')
        padding_right=$(printf '%*s' "$((bar_width - pos - bounce_len))" '')
        bar_line=$(printf "${bg_color}[%s]${reset} [%s%s%s]" "$label" "$padding_left" "$bounce" "$padding_right")
        printf '\r\033[K%s' "$bar_line" > "$_tty"

        # 위치 업데이트
        pos=$((pos + direction))
        if [ $pos -ge $((bar_width - bounce_len)) ]; then
            direction=-1
        elif [ $pos -le 0 ]; then
            direction=1
        fi

        sleep 0.2
    done

    # 남은 출력 표시 (stdout)
    local final_lines
    final_lines=$(wc -l < "$tmpfile")
    if [ "$final_lines" -gt "$last_line_count" ]; then
        printf '\r\033[K' > "$_tty"
        sed -n "$((last_line_count + 1)),${final_lines}p" "$tmpfile"
    fi

    # 바운싱 바 지우기 (tty)
    printf '\r\033[K' > "$_tty"

    # 종료 코드 수집
    wait "$cmd_pid"
    local rc=$?
    rm -f "$tmpfile"
    return $rc
}

# _fmt_duration <seconds>
# Formats a duration as hh:mm:ss always (e.g. 00:30:27). The fixed-width 3-part shape
# matches draw_progress' ETA and stays unambiguous — a 2-part "30:27" reads as either
# 30m27s or 30h27m, "00:30:27" cannot be misread and never shifts width as hours grow.
_fmt_duration() {
    local total=$1
    printf '%02d:%02d:%02d' "$(( total / 3600 ))" "$(( (total % 3600) / 60 ))" "$(( total % 60 ))"
}

# _backup_progress_extra <is_upload:0|1> <pct> <elapsed_seconds>
# Builds the ETA suffix appended after the percentage in the backup bar, shown only
# when pct is in (1,100) and elapsed >= 5s (avoids div-by-zero / wild early estimates).
# ETA is derived from progress rate: eta = elapsed * (100 - pct) / pct.
# Upload uses an approximate pct, so its ETA gets a ~ prefix matching the ~% it shows.
_backup_progress_extra() {
    local is_upload=$1 pct=$2 elapsed=$3
    if [ "$pct" -le 1 ] || [ "$pct" -ge 100 ] || [ "$elapsed" -lt 5 ]; then
        return
    fi
    local eta
    eta=$(_fmt_duration $(( elapsed * (100 - pct) / pct )))
    if [ "$is_upload" -eq 1 ]; then
        printf ' ETA ~%s' "$eta"
    else
        printf ' ETA %s' "$eta"
    fi
}

# run_with_progress_bar <label> <command...>
# backup 전용: stage별 진행률 바를 표시하며 명령 실행
run_with_progress_bar() {
    local label=$1
    shift
    local cmd=("$@")
    local tmpfile
    tmpfile=$(mktemp)
    local tick=0
    local last_line_count=0
    local current_stage=""
    local prev_stage=""
    local repo_completed=0
    local upload_baseline_tx=0
    local upload_target_size=0
    local stage_start=$SECONDS

    _start_size_poller

    # 명령을 백그라운드로 실행, 출력을 임시 파일에 기록
    "${cmd[@]}" > "$tmpfile" 2>&1 &
    local cmd_pid=$!

    while kill -0 "$cmd_pid" 2>/dev/null; do
        # 새 출력 확인 및 표시
        local current_lines
        current_lines=$(wc -l < "$tmpfile")
        if [ "$current_lines" -gt "$last_line_count" ]; then
            printf '\r\033[K' > "$_tty"
            # \r 제거 후 출력
            sed -n "$((last_line_count + 1)),${current_lines}p" "$tmpfile" | tr -d '\r'
            last_line_count=$current_lines
        fi

        # 스테이지 감지
        local detected_stage
        detected_stage=$(sed -n 's/.*-- \(.*\) \.\.\..*/\1/p' "$tmpfile" | tail -1)
        if [ -n "$detected_stage" ]; then
            current_stage="$detected_stage"
        fi

        # 스테이지 전환 시점 처리: 스테이지 시작 시각 기록 + upload 진입 시 baseline tx_bytes/tar 크기 캡처
        if [ "$current_stage" != "$prev_stage" ]; then
            prev_stage="$current_stage"
            stage_start=$SECONDS
            if [[ "$current_stage" == "Uploading backup archive to remote storage"* ]]; then
                upload_baseline_tx=$(_get_current_tx_bytes)
                upload_target_size=$(_get_current_tar_size "_gitlab_backup.tar")
            fi
        fi

        # 스테이지별 진행률 계산
        local pct=-1
        local approx=0
        local display_label="Backup"
        case "$current_stage" in
            "Dumping repositories"*)
                display_label="Backup: Dumping repositories"
                if [ "$_total_project_count" -gt 0 ]; then
                    repo_completed=$(grep -c '"completed create"' "$tmpfile" 2>/dev/null) || repo_completed=0
                    # .wiki 제외
                    local wiki_count
                    wiki_count=$(grep '"completed create"' "$tmpfile" 2>/dev/null | grep -c '\.wiki"') || wiki_count=0
                    repo_completed=$(( repo_completed - wiki_count ))
                    if [ "$repo_completed" -lt 0 ]; then repo_completed=0; fi
                    pct=$(( repo_completed * 100 / _total_project_count ))
                fi
                ;;
            "Dumping uploads"*)
                display_label="Backup: Dumping uploads"
                if [ "$_total_uploads_size" -gt 0 ]; then
                    local cur_size
                    cur_size=$(_get_current_tar_size "uploads.tar.gz")
                    pct=$(( cur_size * 100 / _total_uploads_size ))
                fi
                ;;
            "Dumping builds"*|"Dumping artifacts"*)
                display_label="Backup: Dumping artifacts"
                if [ "$_total_artifacts_size" -gt 0 ]; then
                    local cur_size
                    cur_size=$(_get_current_tar_size "artifacts.tar.gz")
                    pct=$(( cur_size * 100 / _total_artifacts_size ))
                fi
                ;;
            "Dumping lfs objects"*)
                display_label="Backup: Dumping lfs objects"
                if [ "$_total_lfs_size" -gt 0 ]; then
                    local cur_size
                    cur_size=$(_get_current_tar_size "lfs.tar.gz")
                    pct=$(( cur_size * 100 / _total_lfs_size ))
                fi
                ;;
            "Uploading backup archive to remote storage"*)
                # fog SDK가 chunk마다 file을 open/close해서 FD-기반 추적이 불가능하므로
                # 컨테이너 egress 누적 바이트와 tar 크기 비율로 근사 (~ prefix로 명시).
                # ambient 트래픽(exporter, sidekiq)은 보통 GB급 업로드 대비 노이즈 < 1%.
                display_label="Backup: Uploading to remote storage"
                if [ "$upload_target_size" -gt 0 ]; then
                    local now_tx sent
                    now_tx=$(_get_current_tx_bytes)
                    sent=$(( now_tx - upload_baseline_tx ))
                    if [ "$sent" -gt 0 ]; then
                        pct=$(( sent * 100 / upload_target_size ))
                        approx=1
                    fi
                fi
                ;;
            *)
                if [ -n "$current_stage" ]; then
                    display_label="Backup: $current_stage"
                fi
                ;;
        esac

        if [ "$pct" -ge 0 ]; then
            # ETA 부가 정보 계산 (pct 캡 전 raw 값 사용; upload는 ~ 접두사)
            local is_upload=0
            [[ "$current_stage" == "Uploading backup archive to remote storage"* ]] && is_upload=1
            local extra
            extra=$(_backup_progress_extra "$is_upload" "$pct" "$(( SECONDS - stage_start ))")
            if [ "$pct" -gt 100 ]; then pct=100; fi
            _draw_backup_progress "$display_label" "$pct" "$tick" "$approx" "$extra"
        else
            _draw_bouncing_frame "$display_label" "$tick"
        fi

        tick=$(( tick + 1 ))
        sleep 0.2
    done

    _stop_size_poller

    # 남은 출력 표시
    local final_lines
    final_lines=$(wc -l < "$tmpfile")
    if [ "$final_lines" -gt "$last_line_count" ]; then
        printf '\r\033[K' > "$_tty"
        sed -n "$((last_line_count + 1)),${final_lines}p" "$tmpfile" | tr -d '\r'
    fi

    # 바 지우기
    printf '\r\033[K' > "$_tty"

    # 종료 코드 수집
    wait "$cmd_pid"
    local rc=$?
    rm -f "$tmpfile"
    return $rc
}

# poll_with_bouncing_bar <label> <check_cmd...>
# check_cmd가 성공(exit 0)할 때까지 바운싱 바 + docker logs 표시
poll_with_bouncing_bar() {
    local label=$1
    shift
    local cond=("$@")
    local tmpfile
    tmpfile=$(mktemp)
    local cols=${COLUMNS:-$(tput cols 2>/dev/null || stty size 2>/dev/null | awk '{print $2}' || echo 80)}
    local pos=0
    local direction=1
    local bounce='#####'
    local bounce_len=${#bounce}
    local reset='\033[0m'
    local bg_color bar_width padding_left padding_right bar_line
    local last_line_count=0
    local tick=0

    # docker logs --follow --tail 0: 새로운 로그만 스트리밍 (CI/DinD에서는 TCP hang 방지를 위해 생략)
    local logs_pid=
    if [ "${CI:-}" != "true" ]; then
        docker logs --follow --tail 0 "$CONTAINER_NAME" > "$tmpfile" 2>&1 &
        logs_pid=$!
    fi

    while ! "${cond[@]}" 2>/dev/null; do
        # 새 로그 출력 확인 및 표시
        local current_lines
        current_lines=$(wc -l < "$tmpfile")
        if [ "$current_lines" -gt "$last_line_count" ]; then
            printf '\r\033[K' > "$_tty"
            sed -n "$((last_line_count + 1)),${current_lines}p" "$tmpfile"
            last_line_count=$current_lines
        fi

        # bar_width 계산
        bar_width=$(( cols - ${#label} - 5 ))
        if [ "$bar_width" -lt 10 ]; then
            bar_width=10
        fi
        if [ $pos -ge $((bar_width - bounce_len)) ]; then
            pos=$((bar_width - bounce_len - 1))
            direction=-1
        fi

        # 배경색
        bg_color='\033[42;30m'
        if [ "${_trap_active:-0}" -eq 1 ]; then
            bg_color='\033[43;30m'
        fi

        # 바운싱 바 그리기
        padding_left=$(printf '%*s' "$pos" '')
        padding_right=$(printf '%*s' "$((bar_width - pos - bounce_len))" '')
        bar_line=$(printf "${bg_color}[%s]${reset} [%s%s%s]" "$label" "$padding_left" "$bounce" "$padding_right")
        printf '\r\033[K%s' "$bar_line" > "$_tty"

        pos=$((pos + direction))
        if [ $pos -ge $((bar_width - bounce_len)) ]; then
            direction=-1
        elif [ $pos -le 0 ]; then
            direction=1
        fi

        # 컨테이너 사망 검사 (5회마다 = ~1초 간격)
        tick=$((tick + 1))
        if [ $((tick % 5)) -eq 0 ]; then
            print_stacktrace_errors
        fi

        sleep 0.2
    done

    # docker logs 프로세스 종료
    if [ -n "$logs_pid" ]; then
        kill "$logs_pid" 2>/dev/null
        wait "$logs_pid" 2>/dev/null
    fi

    # 남은 로그 표시
    local final_lines
    final_lines=$(wc -l < "$tmpfile")
    if [ "$final_lines" -gt "$last_line_count" ]; then
        printf '\r\033[K' > "$_tty"
        sed -n "$((last_line_count + 1)),${final_lines}p" "$tmpfile"
    fi

    printf '\r\033[K' > "$_tty"
    rm -f "$tmpfile"
}

# --- 업그레이드 경로 데이터 소스 결정 ---
_GITLAB_PROJECT_ID="278964"  # gitlab-org/gitlab
_TAGS_URL="https://gitlab-com.gitlab.io/support/toolbox/upgrade-path/path.json"

# --- N-1 버전 결정 (공통 헬퍼) ---
# 인자: 최신버전, 후보목록(줄바꿈 구분)
# stdout: N-1 태그 (없으면 빈 문자열)
_resolve_n1() {
    local latest_ver=$1 candidates=$2
    local latest_major latest_minor
    latest_major=${latest_ver%%.*}
    latest_minor=$(echo "$latest_ver" | awk -F'[.-]' '{print $2}')

    if [ "$latest_minor" -eq 0 ]; then
        local prev_major=$((latest_major - 1))
        echo "$candidates" | grep -E "^${prev_major}\." | sort -V | tail -1
    else
        local prev_minor=$((latest_minor - 1))
        echo "$candidates" | grep -E "^${latest_major}\.${prev_minor}\.[0-9]+" | sort -V | tail -1
    fi
}


# --- EOS (End-of-Support) 체크 ---
# GitLab 공개 API로 현재 지원 중인 3개 마이너 트랙 조회
_check_eos() {
    # target_version_tag가 없으면 (latest 대상) 스킵
    [ -z "$target_version_tag" ] && return 0

    local releases supported_minors target_major target_minor
    releases=$(curl -sf "https://gitlab.com/api/v4/projects/${_GITLAB_PROJECT_ID}/releases?per_page=3")
    if [ -z "$releases" ]; then
        echo "Warning: Could not check EOS status (GitLab API unreachable)" >&2
        return 0  # API 실패 시 차단하지 않음
    fi

    # 지원 트랙 추출: v18.9.0-ee → 18.9
    supported_minors=$(echo "$releases" | jq -r '.[].tag_name' | sed 's/^v//;s/\.[0-9]*-.*$//')

    # 타겟의 major.minor 추출 (suffix 제거)
    target_major=$(echo "$target_version_tag" | awk -F'[.-]' '{print $1}')
    target_minor=$(echo "$target_version_tag" | awk -F'[.-]' '{print $2}')

    if ! echo "$supported_minors" | grep -qx "${target_major}\.${target_minor}"; then
        echo "Error: ${target_major}.${target_minor} is end-of-support." >&2
        echo "Supported tracks: $(echo "$supported_minors" | tr '\n' ', ' | sed 's/,$//')" >&2
        exit 1
    fi
}

# --- 통합 경로: path.json (경유 버전) + Docker Hub (패치 해석) ---
_fetch_upgrade_path() {
    # 1. path.json → 필수 경유 버전 (major.minor)
    local path_json
    path_json=$(curl -sf "$_TAGS_URL")
    if [ -z "$path_json" ]; then
        echo "FATAL ERROR: Failed to fetch path.json from $_TAGS_URL" >&2
        exit 1
    fi

    # path.json .all[] → unique major.minor 경유 버전 추출
    local -a waypoints
    mapfile -t waypoints < <(echo "$path_json" | jq -r '.all[]' | awk -F. '{print $1"."$2}' | sort -Vu)

    # 2. Docker Hub 태그 일괄 조회 (partial version resolve에서도 재활용)
    local cur_major max_waypoint_major max_major
    __all_docker_tags=""
    cur_major=${CURRENT_VERSION%%.*}
    max_waypoint_major=$(printf '%s\n' "${waypoints[@]}" | awk -F. '{print $1}' | sort -n | tail -1)
    max_major=$(( max_waypoint_major > cur_major ? max_waypoint_major + 1 : cur_major + 1 ))

    echo "Fetching Docker Hub tags for ${GITLAB_IMAGE} (major ${cur_major}-${max_major})..."
    local maj page_url response page_tags next
    for (( maj=cur_major; maj<=max_major; maj++ )); do
        page_url="https://hub.docker.com/v2/repositories/${GITLAB_IMAGE}/tags/?name=${maj}.&page_size=100"
        while [ -n "$page_url" ]; do
            response=$(curl -sf "$page_url")
            [ -z "$response" ] && break
            page_tags=$(echo "$response" | jq -r '.results[].name' | grep -E "^${maj}\.")
            _all_docker_tags="${_all_docker_tags}${page_tags}"$'\n'
            next=$(echo "$response" | jq -r '.next // empty')
            page_url="$next"
        done
    done
    _all_docker_tags=$(echo "$_all_docker_tags" | sed '/^$/d' | sort -Vu)

    if [ -z "$_all_docker_tags" ]; then
        echo "FATAL ERROR: No Docker Hub tags found for ${GITLAB_IMAGE}" >&2
        exit 1
    fi

    # 3. 최신 버전 결정
    LATEST_VERSION_TAG=$(echo "$_all_docker_tags" | sort -V | tail -1)

    # 4. N-1 전략
    if [ $skip_latest -eq 1 ]; then
        if [[ "$target_version_tag" =~ ^[0-9]+$ ]]; then
            # major-scoped N-1
            local scoped_major=$target_version_tag
            local scoped_candidates
            scoped_candidates=$(echo "$_all_docker_tags" | grep "^${scoped_major}\.")
            local latest_in_major
            latest_in_major=$(echo "$scoped_candidates" | sort -V | tail -1)

            if [ -z "$latest_in_major" ]; then
                echo "Warning: No versions found for major ${scoped_major} — skipping N-1" >&2
            else
                local n1_tag
                n1_tag=$(_resolve_n1 "$latest_in_major" "$_all_docker_tags")

                if [ -n "$n1_tag" ]; then
                    target_version_tag="$n1_tag"
                    _partial_version=0
                    echo "Skip-latest (N-1) mode: targeting $target_version_tag"
                else
                    # N-1 불가 → latest within major 사용
                    target_version_tag="$latest_in_major"
                    _partial_version=0
                    echo "Warning: Could not determine N-1 for ${scoped_major}.x — using latest ${target_version_tag}" >&2
                fi
            fi
        elif [ -z "$target_version_tag" ]; then
            # 전체 범위 N-1
            local n1_tag
            n1_tag=$(_resolve_n1 "$LATEST_VERSION_TAG" "$_all_docker_tags")

            # N-1 대상이 현재 태그에 없으면 해당 메이저 추가 조회
            if [ -z "$n1_tag" ]; then
                local prev_major prev_major_tags=""
                prev_major=$(( ${LATEST_VERSION_TAG%%.*} - 1 ))
                page_url="https://hub.docker.com/v2/repositories/${GITLAB_IMAGE}/tags/?name=${prev_major}.&page_size=100"
                while [ -n "$page_url" ]; do
                    response=$(curl -sf "$page_url")
                    [ -z "$response" ] && break
                    page_tags=$(echo "$response" | jq -r '.results[].name' | grep -E "^${prev_major}\.")
                    prev_major_tags="${prev_major_tags}${page_tags}"$'\n'
                    next=$(echo "$response" | jq -r '.next // empty')
                    page_url="$next"
                done
                n1_tag=$(echo "$prev_major_tags" | sed '/^$/d' | sort -V | tail -1)
            fi

            if [ -n "$n1_tag" ]; then
                target_version_tag="$n1_tag"
                echo "Skip-latest (N-1) mode: targeting $target_version_tag"
            else
                echo "Warning: Could not determine N-1 version, using latest" >&2
            fi
        fi
    fi

    # 5. ALL_TAGS 구성: 각 경유 버전의 최신 패치를 Docker Hub에서 해석
    ALL_TAGS=()
    local wp wp_major wp_minor resolved
    for wp in "${waypoints[@]}"; do
        wp_major=${wp%%.*}
        wp_minor=${wp#*.}
        resolved=$(echo "$_all_docker_tags" | grep -E "^${wp_major}\.${wp_minor}\.[0-9]+" | sort -V | tail -1)
        [ -n "$resolved" ] && ALL_TAGS+=("$resolved")
    done

    # 최신 버전 또는 target_version_tag 추가
    if [ -n "$target_version_tag" ]; then
        ALL_TAGS+=("$target_version_tag")
    else
        ALL_TAGS+=("$LATEST_VERSION_TAG")
    fi

    # 정렬 + 중복 제거
    mapfile -t ALL_TAGS < <(printf '%s\n' "${ALL_TAGS[@]}" | sort -Vu)
}

echo "Processing GitLab-${GITLAB_EDITION^^} upgrade path..."
_fetch_upgrade_path

# partial version resolve
if [ "$_partial_version" -eq 1 ]; then
    resolved=$(printf '%s\n' "${ALL_TAGS[@]}" | grep "^${target_version_tag}\." | sort -V | tail -1)

    # ALL_TAGS에 없으면 이미 조회한 Docker Hub 태그에서 검색
    if [ -z "$resolved" ] && [[ "$target_version_tag" =~ ^[0-9]+\.[0-9]+$ ]]; then
        partial_major=${target_version_tag%%.*}
        partial_minor=${target_version_tag#*.}
        resolved=$(echo "$_all_docker_tags" | grep -E "^${partial_major}\.${partial_minor}\.[0-9]+" | sort -V | tail -1)
    fi

    if [ -z "$resolved" ]; then
        echo "Error: No tags matching '${target_version_tag}.*' found." >&2
        target_version_tag=
    else
        target_version_tag="$resolved"
        echo "Resolved partial version to: $target_version_tag"
        # ALL_TAGS에 없으면 추가
        if [[ " ${ALL_TAGS[*]} " != *" $target_version_tag "* ]]; then
            ALL_TAGS+=("$target_version_tag")
            mapfile -t ALL_TAGS < <(printf '%s\n' "${ALL_TAGS[@]}" | sort -Vu)
        fi
    fi
fi

# EOS (End-of-Support) 체크
_check_eos

# 1. 현재 버전 이후만 필터링
UPDATABLE_TAGS=()

count=1
for idx in "${!ALL_TAGS[@]}"; do
    tag="${ALL_TAGS[$idx]}"
    draw_progress $count ${#ALL_TAGS[@]} "Listing tags after $CURRENT_VERSION" 'Item'

    if [[ "$(printf '%s\n%s\n' "$CURRENT_VERSION" "$tag" | sort -V | head -n1)" != "$tag" ]]; then
        UPDATABLE_TAGS+=("$tag")
    fi
    count=$((count + 1))
done

if [ -n "$target_version_tag" ]; then
    TEMP=()
    count=1
    for idx in "${!UPDATABLE_TAGS[@]}"; do
        tag="${UPDATABLE_TAGS[$idx]}"
        draw_progress $count ${#UPDATABLE_TAGS[@]} "Listing tags before $target_version_tag" 'Item'

        if [[ "$(printf '%s\n%s\n' "$tag" "$target_version_tag" | sort -V | head -n1)" == "$tag" ]]; then
            TEMP+=("$tag")
        fi
        count=$((count + 1))
    done

    UPDATABLE_TAGS=("${TEMP[@]}")
fi

# 2. 업그레이드 경로 구성
# path.json 기반 필수 경유 버전 (패치는 Docker Hub에서 해석)
UPGRADE_POINTS_ARRAY=("${UPDATABLE_TAGS[@]}")

# CE → EE 전환 시 같은 버전의 EE 태그를 라우팅 포인트 맨 앞에 추가
if [ "$DETECTED_EDITION" != "$GITLAB_EDITION" ]; then
    EDITION_SWITCH_TAG="${CURRENT_VERSION/-${DETECTED_EDITION}./-${GITLAB_EDITION}.}"
    # 이미 배열에 포함되어 있으면 중복 추가하지 않음
    if [[ " ${UPGRADE_POINTS_ARRAY[*]} " != *" $EDITION_SWITCH_TAG "* ]]; then
        UPGRADE_POINTS_ARRAY=("$EDITION_SWITCH_TAG" "${UPGRADE_POINTS_ARRAY[@]}")
    fi
fi

if [ $dry_run -eq 1 ]; then
    echo ""
    echo "=== DRY-RUN: Upgrade Path ==="
    echo "Container: $CONTAINER_NAME"
    echo "Current: $CURRENT_VERSION"
    echo "Edition: $GITLAB_EDITION"
    echo "Target: ${target_version_tag:-$LATEST_VERSION_TAG}"
    echo "Steps: ${#UPGRADE_POINTS_ARRAY[@]}"
    for idx in "${!UPGRADE_POINTS_ARRAY[@]}"; do
        echo "  $((idx + 1)). ${UPGRADE_POINTS_ARRAY[$idx]}"
    done
    exit 0
fi

if [ -z "$TARGET_URL" ] && [ "${CI:-}" != "true" ]; then
    if [ $auto_yes -eq 1 ]; then
        echo "Error: TARGET_URL is required for unattended mode (-y). Use --target-url or TARGET_URL env." >&2
        exit 1
    fi
    echo 'TARGET_URL is not configured yet. Please enter your GitLab server URL.'
    echo 'e.g.: https://gitlab.com'
    echo -n '> '
    read -r TARGET_URL < "$_tty"
    if [ -z "$TARGET_URL" ]; then
        echo 'User abort'
        exit 1
    fi
fi

# -y 모드는 FATAL 등 중대 이벤트가 알림 없이 로그에 묻히지 않도록 Discord 알림을 필수화
if [ $auto_yes -eq 1 ] && [ "${CI:-}" != "true" ] && [ -z "$DISCORD_URL" ]; then
    echo "Error: DISCORD_URL is required for unattended mode (-y) so fatal events can be surfaced. Use --discord-url or DISCORD_URL env." >&2
    exit 1
fi

if [ $auto_yes -eq 1 ] && [ $no_step_limit -eq 0 ] && [ ${#UPGRADE_POINTS_ARRAY[@]} -ge 3 ]; then
    echo "Error: Upgrade path has ${#UPGRADE_POINTS_ARRAY[@]} steps (>= 3). Too many steps for unattended mode (-y)." >&2
    echo "Please run manually without -y flag." >&2
    send_discord_webhook "WARN" "Unattended upgrade aborted" "Upgrade path has ${#UPGRADE_POINTS_ARRAY[@]} steps (>= 3), manual intervention required."
    exit 1
fi

if [ ${#UPGRADE_POINTS_ARRAY[@]} -eq 0 ]; then
    if [ "${_prev_exit:-0}" -ne 0 ]; then
        echo "Resuming post-upgrade checks for $CURRENT_VERSION..."
        enter_critical
        wait_for_http_ready "Recovery"
        wait_for_healthy "Recovery"
        wait_for_background_migrations
        check_migration_status
        check_gitlab_server_healthy 1
        check_secrets_integrity "post-upgrade"
        exit_critical
        echo "WARNING: Previous run exited abnormally (exit code: $_prev_exit)"
        if [ "$_interrupted" -eq 1 ]; then
            exit 130
        fi
    else
        echo "Requirements already satisfied: v$CURRENT_VERSION"
        if ! curl -sf -o /dev/null "$TARGET_URL/users/sign_in"; then
            echo "NOTE: If your GitLab server does not work properly, please edit $(docker inspect "$CONTAINER_NAME" --format='{{range .Mounts}}{{.Source}}:{{.Destination}} {{end}}' | tr ' ' '\n' | grep /etc/gitlab | awk -F ':' '{ print $1 }')/gitlab.rb file or 'docker exec -it $CONTAINER_NAME /bin/bash && vi /etc/gitlab/gitlab.rb'"
        fi
    fi
    exit 0
fi

echo -e "\nWould you like to upgrade GitLab server from $CURRENT_VERSION to ${UPGRADE_POINTS_ARRAY[-1]}?"
echo "This action cannot be undone. PLEASE BACKUP GitLab drive BEFORE STARTING UPDATE..."
echo "You should update pointing releases too. ROUTING COUNT: ${#UPGRADE_POINTS_ARRAY[@]}"
if [ ${#UPGRADE_POINTS_ARRAY[@]} -lt 10 ]; then
    for idx in "${!UPGRADE_POINTS_ARRAY[@]}"; do
        echo -e "\t$((idx + 1)). ${UPGRADE_POINTS_ARRAY[$idx]}"
    done
fi
if [ ${#UPGRADE_POINTS_ARRAY[@]} -le 5 ]; then
    echo -e "\ttraceroute: ${UPGRADE_POINTS_ARRAY[*]}"
fi
echo "Follow this link to get more information: https://gitlab-com.gitlab.io/support/toolbox/upgrade-path/?current=${CURRENT_VERSION%%-*}&target=${UPGRADE_POINTS_ARRAY[-1]%%-*}&distro=docker&edition=${GITLAB_EDITION}"
echo ''
echo -e "\t- I understood that this action DOES NOT SUPPORT rollback"
echo -e "\t- I understood that this action may take a long time due to the ROUTING COUNT."
echo -e "\t- I checked container restart policy: $(docker inspect --format='{{.HostConfig.RestartPolicy.Name}}' "$CONTAINER_NAME")"
_ports=$(docker inspect "$CONTAINER_NAME" --format='{{range $p, $conf := .NetworkSettings.Ports}}{{if $conf}}{{$p}} -> {{(index $conf 0).HostPort}} {{end}}{{end}}' 2>/dev/null)
echo -e "\t- I checked container PORTS: ${_ports:-not configured}"
echo -e "\t- I checked container DRIVE: $(docker inspect "$CONTAINER_NAME" --format='{{range .Mounts}}{{.Source}}:{{.Destination}} {{end}}')"
echo -e "\t- I checked gitlab external_url in gitlab.rb file: $(docker exec "$CONTAINER_NAME" grep '^external_url' /etc/gitlab/gitlab.rb | awk -F"'" '{print $2}')"
echo -e "\t- I checked gitlab backup_path in gitlab.rb file: $(docker exec "$CONTAINER_NAME" grep "'backup_path'" /etc/gitlab/gitlab.rb | awk -F"=" '{print $2}' | sed 's/\"//g' | sed 's/^ //')"
PAUSED_RUNNER_IDS=""
active_runners=0
total_runners=$(docker exec "$CONTAINER_NAME" gitlab-psql -tAc "SELECT COUNT(*) FROM ci_runners;" 2>/dev/null | tr -d '[:space:]')
if ! [[ "$total_runners" =~ ^[0-9]+$ ]]; then
    # 쿼리 실패 시 빈 값을 "러너 0개"로 오인하지 않는다 — 알 수 없으므로 일시정지를 건너뛴다.
    echo -e "\t- Warning: could not query the runner table (DB error); skipping runner pause. Verify runners manually." >&2
    total_runners=0
fi
if [ "$total_runners" -eq 0 ]; then
    echo -e "\t- I checked this GitLab server has not configured any runners yet."
else
    echo ''
    echo -e "\t- I checked this GitLab server is configured with the following runners:"
    docker exec "$CONTAINER_NAME" gitlab-psql -c "SELECT id, description, contacted_at, active FROM ci_runners ORDER BY id;"
    echo ''
    active_runners=$(docker exec "$CONTAINER_NAME" gitlab-psql -tAc "SELECT COUNT(*) FROM ci_runners WHERE active = true;" 2>/dev/null | tr -d '[:space:]')
    [[ "$active_runners" =~ ^[0-9]+$ ]] || active_runners=0
    if [ "$active_runners" -gt 0 ]; then
        echo -e "\t- I checked $active_runners active runner(s) will be paused after I accept this notice (resumed after the upgrade)"
    fi
fi
echo -e "\t- I checked TARGET_URL is valid: $TARGET_URL"

if [ $auto_yes -eq 1 ]; then
    echo -e "\nAuto-confirmed (-y mode)."
else
    echo -en "\nI accept the above notice and continue this job (y/N) > "
    read -r n < "$_tty"
    if [ "$n" != "y" ] && [ "$n" != "Y" ]; then
        echo 'User abort' >&2
        exit 1
    fi
fi

# 약관 동의 이후에만 runner를 일시정지한다 — 동의 거부 시 runner는 건드리지 않으므로
# 조기 abort로 runner가 일시정지된 채 방치되는 일이 없다.
if [ "$active_runners" -gt 0 ]; then
    if [ $auto_yes -eq 0 ]; then
        echo -n "Pause runners automatically? (Y/n) > "
        read -r runner_confirm < "$_tty"
        if [ "$runner_confirm" == "n" ] || [ "$runner_confirm" == "N" ]; then
            echo "Aborted. Pause runners in Admin > Runners, then re-run this script."
            exit 1
        fi
    fi
    echo "Pausing $active_runners active runner(s)..."
    PAUSED_RUNNER_IDS=$(docker exec "$CONTAINER_NAME" gitlab-psql -tAc "SELECT id FROM ci_runners WHERE active = true;")
    docker exec "$CONTAINER_NAME" gitlab-psql -c "UPDATE ci_runners SET active = false WHERE active = true;" > /dev/null
    echo "Runners paused. They will be resumed after the upgrade."
fi

send_discord_webhook "NOTE" "Updating GitLab now!" "GitLab will be upgraded from $CURRENT_VERSION to ${UPGRADE_POINTS_ARRAY[-1]}"
auto_restart_enabled=$(docker inspect --format='{{.HostConfig.RestartPolicy.Name}}' "$CONTAINER_NAME")

# 0. 디스크 여유 공간 사전 검증
check_disk_space

echo "Creating backups for $CURRENT_VERSION. Please wait until backup process is completed..."
if [ $skip_lfs -eq 1 ]; then
    echo "Note: LFS objects will be skipped during backup (--skip-lfs)."
fi
_query_backup_stats
if docker exec "$CONTAINER_NAME" which gitlab-backup &>/dev/null; then
    if [ "$_backup_stats_available" -eq 1 ]; then
        if [ $skip_lfs -eq 1 ]; then
            run_with_progress_bar "Backup" docker exec -t -e TERM=dumb -e SKIP=lfs "$CONTAINER_NAME" gitlab-backup create
        else
            run_with_progress_bar "Backup" docker exec -t -e TERM=dumb "$CONTAINER_NAME" gitlab-backup create
        fi
    else
        if [ $skip_lfs -eq 1 ]; then
            run_with_bouncing_bar "Backup" docker exec -e SKIP=lfs "$CONTAINER_NAME" gitlab-backup create
        else
            run_with_bouncing_bar "Backup" docker exec "$CONTAINER_NAME" gitlab-backup create
        fi
    fi
else
    if [ "$_backup_stats_available" -eq 1 ]; then
        if [ $skip_lfs -eq 1 ]; then
            run_with_progress_bar "Backup" docker exec -t -e TERM=dumb "$CONTAINER_NAME" gitlab-rake gitlab:backup:create SKIP=lfs
        else
            run_with_progress_bar "Backup" docker exec -t -e TERM=dumb "$CONTAINER_NAME" gitlab-rake gitlab:backup:create
        fi
    else
        if [ $skip_lfs -eq 1 ]; then
            run_with_bouncing_bar "Backup" docker exec "$CONTAINER_NAME" gitlab-rake gitlab:backup:create SKIP=lfs
        else
            run_with_bouncing_bar "Backup" docker exec "$CONTAINER_NAME" gitlab-rake gitlab:backup:create
        fi
    fi
fi
BACKUP_DIR=$(docker exec "$CONTAINER_NAME" grep "'backup_path'" /etc/gitlab/gitlab.rb 2>/dev/null | awk -F"=" '{ print $2 }' | sed 's/\"//g' | sed 's/^ //')
if [ -z "$BACKUP_DIR" ]; then
    # gitlab.rb에 backup_path 줄이 없으면 빈 값을 그대로 쓰지 않고 GitLab 기본 경로로 폴백한다
    # (빈 값이면 cp 대상이 컨테이너 루트가 되고 hook에도 빈 경로가 전달됨).
    BACKUP_DIR="/var/opt/gitlab/backups"
    echo "Note: backup_path not found in gitlab.rb; using GitLab default $BACKUP_DIR for config snapshots."
fi
docker exec "$CONTAINER_NAME" sh -c "cp /etc/gitlab/gitlab-secrets.json $BACKUP_DIR/gitlab-secrets.json.${CURRENT_VERSION}-backup"
docker exec "$CONTAINER_NAME" sh -c "cp /etc/gitlab/gitlab.rb $BACKUP_DIR/gitlab.rb.${CURRENT_VERSION}-backup"

# config backup 정리: gitlab.rb의 backup_keep_time(초) 기준으로 오래된 파일 삭제.
# GitLab 본체 *.tar 백업과 동일한 retention 정책. 0/미설정이면 영구 보관.
backup_keep_time=$(docker exec "$CONTAINER_NAME" grep "'backup_keep_time'" /etc/gitlab/gitlab.rb 2>/dev/null \
    | awk -F"=" '{print $2}' | sed 's/\"//g' | sed 's/^ //')
if [[ "$backup_keep_time" =~ ^[0-9]+$ ]] && [ "$backup_keep_time" -gt 0 ]; then
    keep_minutes=$((backup_keep_time / 60))
    if [ "$keep_minutes" -gt 0 ]; then
        docker exec "$CONTAINER_NAME" sh -c \
            "find '$BACKUP_DIR' -maxdepth 1 -type f \( -name 'gitlab.rb.*-backup' -o -name 'gitlab-secrets.json.*-backup' \) -mmin +$keep_minutes -delete 2>/dev/null" || true
        echo "Pruned config backups older than ${backup_keep_time}s (backup_keep_time)"
    fi
fi

# 사용자 hook: config 백업 직후 임의 처리 (예: 원격지 업로드).
# UPGRADE_GITLAB_CONFIG_HOOK 환경변수로 지정 가능. 미설정이면
# upgrade-gitlab 스크립트와 같은 디렉토리의 upload-config.hook을 자동 탐지.
# 실패 시 warning만 찍고 업그레이드는 계속 진행 (config 사본은 로컬에 남아있음).
# Hook은 컨테이너 측 BACKUP_DIR 경로를 받음 — host 경로 해석은 docker cp 등에 위임.
if [ -z "$config_backup_hook" ] && [ -n "$SCRIPT_DIR" ]; then
    _hook_candidate="${SCRIPT_DIR}/upload-config.hook"
    if [ -e "$_hook_candidate" ]; then
        if [ -x "$_hook_candidate" ]; then
            config_backup_hook="$_hook_candidate"
            echo "Auto-detected post-config-backup hook: $config_backup_hook"
        else
            echo "Warning: $_hook_candidate exists but is not executable, skipping auto-discovery" >&2
        fi
    fi
fi

if [ -n "$config_backup_hook" ]; then
    if [ ! -x "$config_backup_hook" ]; then
        echo "Warning: UPGRADE_GITLAB_CONFIG_HOOK is not executable: $config_backup_hook" >&2
    else
        echo "Running post-config-backup hook: $config_backup_hook"
        if ! UPGRADE_GITLAB_BACKUP_DIR="$BACKUP_DIR" \
             UPGRADE_GITLAB_VERSION="$CURRENT_VERSION" \
             UPGRADE_GITLAB_CONTAINER="$CONTAINER_NAME" \
             UPGRADE_GITLAB_SCRIPT_DIR="$SCRIPT_DIR" \
             "$config_backup_hook"; then
            echo "Warning: post-config-backup hook exited non-zero (continuing upgrade)" >&2
        fi
    fi
fi

# Secrets 무결성 기준선 확인
if ! check_secrets_integrity "pre-upgrade"; then
    if [ $auto_yes -eq 1 ]; then
        echo "Aborted due to secrets integrity check failure (-y mode)." >&2
        exit 1
    fi
    echo -n "Continue despite secrets integrity warning? (y/N) > "
    read -r secrets_confirm < "$_tty"
    if [ "$secrets_confirm" != "y" ] && [ "$secrets_confirm" != "Y" ]; then
        echo "Aborted due to secrets integrity check failure." >&2
        exit 1
    fi
fi

# 약관 동의 + 백업 + 사전 검증을 모두 통과한 시점부터 끝까지를 단일 critical zone으로.
# SIGINT/SIGTERM/SIGTSTP/SIGHUP은 deferred → 다음 안전 checkpoint(=각 iteration 끝, post-upgrade 끝)에서 처리.
enter_critical

# 에디션 전환 (같은 버전에서 CE → EE)
if [ "$DETECTED_EDITION" != "$GITLAB_EDITION" ]; then
    echo "Switching edition at current version: $CURRENT_VERSION -> $EDITION_SWITCH_TAG"
    send_discord_webhook "INFO" "Switching edition: $DETECTED_EDITION -> $GITLAB_EDITION" "Same version edition switch before version upgrades"

    wait_for_background_migrations
    check_gitlab_server_healthy 0

    if docker ps --format "{{.Names}}" | grep -q "^$CONTAINER_NAME$"; then
        echo "stopping $CURRENT_VERSION container..."
        if [ "${CI:-}" = "true" ]; then
            run_with_bouncing_bar "Stopping" docker stop "$CONTAINER_NAME"
        else
            run_with_bouncing_bar "Stopping" bash -c "
                docker logs --follow --tail 0 \"$CONTAINER_NAME\" &
                logs_pid=\$!
                docker stop \"$CONTAINER_NAME\" 2>&1
                kill \$logs_pid 2>/dev/null
                wait \$logs_pid 2>/dev/null
            "
        fi
        echo 'done'
    fi
    echo -n "removing $CURRENT_VERSION container..."
    docker container rm "$CONTAINER_NAME" &> /dev/null
    echo ' done'

    echo -n "removing previous $CURRENT_VERSION image..."
    docker image rm "gitlab/gitlab-${DETECTED_EDITION}:$CURRENT_VERSION" &> /dev/null
    echo ' done'

    pull_with_retry "$GITLAB_IMAGE:$EDITION_SWITCH_TAG"

    # shellcheck disable=SC2086
    docker run -d --name "$CONTAINER_NAME" $VOLUMES $PORTS "$GITLAB_IMAGE:$EDITION_SWITCH_TAG"

    wait_for_http_ready "$GITLAB_IMAGE:$EDITION_SWITCH_TAG"
    wait_for_healthy "$GITLAB_IMAGE:$EDITION_SWITCH_TAG"

    wait_for_background_migrations
    check_migration_status

    CURRENT_VERSION=$EDITION_SWITCH_TAG
    echo "Edition switch completed: now running $GITLAB_IMAGE:$EDITION_SWITCH_TAG"
    send_discord_webhook "NOTE" "Edition switch completed" "Now running $GITLAB_IMAGE:$EDITION_SWITCH_TAG"

    # 에디션 전환 포인트를 라우팅 배열에서 제거 (이미 처리됨)
    UPGRADE_POINTS_ARRAY=("${UPGRADE_POINTS_ARRAY[@]:1}")
fi

index=1
CNT_VERSION=$CURRENT_VERSION
for ver in "${UPGRADE_POINTS_ARRAY[@]}"; do
    # 안전 checkpoint: 이전 iteration 도중 또는 CE→EE 도중 SIGINT가 들어왔으면
    # 새 버전 진입 안 하고 break, post-upgrade로 직행.
    if [ "$_interrupted" -eq 1 ]; then
        echo "Interrupted at safe checkpoint. Stopping upgrade loop. Running post-upgrade verification." >&2
        break
    fi

    send_discord_webhook "INFO" "GitLab server is upgrading now! ($index/${#UPGRADE_POINTS_ARRAY[@]})" "Please wait until upgrading process is done."
    echo "Updating $CNT_VERSION to $ver... ($index/${#UPGRADE_POINTS_ARRAY[@]})"

    # 다음 버전 이미지 사전 Pull (백그라운드)
    PULL_PID=
    if [ $index -lt ${#UPGRADE_POINTS_ARRAY[@]} ]; then
        next_ver="${UPGRADE_POINTS_ARRAY[$index]}"
        docker pull "$GITLAB_IMAGE:$next_ver" &> /dev/null &
        PULL_PID=$!
    fi

    if ! docker ps --format "{{.Names}}" | grep -q "^$CONTAINER_NAME$"; then
        docker start "$CONTAINER_NAME" &> /dev/null
        wait_for_healthy "$GITLAB_IMAGE:$CNT_VERSION"
    fi

    wait_for_background_migrations
    check_gitlab_server_healthy 0

    if docker ps --format "{{.Names}}" | grep -q "^$CONTAINER_NAME$"; then
        echo "stopping $CNT_VERSION container..."
        if [ "${CI:-}" = "true" ]; then
            run_with_bouncing_bar "Stopping" docker stop "$CONTAINER_NAME"
        else
            run_with_bouncing_bar "Stopping" bash -c "
                docker logs --follow --tail 0 \"$CONTAINER_NAME\" &
                logs_pid=\$!
                docker stop \"$CONTAINER_NAME\" 2>&1
                kill \$logs_pid 2>/dev/null
                wait \$logs_pid 2>/dev/null
            "
        fi
        echo 'done'
    fi
    echo -n "removing $CNT_VERSION container..."
    docker container rm "$CONTAINER_NAME" &> /dev/null
    echo ' done'

    echo -n "removing previous $CNT_VERSION image..."
    docker image rm "$GITLAB_IMAGE:$CNT_VERSION" &> /dev/null
    echo ' done'

    # 사전 Pull 완료 대기
    if [ -n "$PULL_PID" ]; then
        wait "$PULL_PID" 2>/dev/null || true
        PULL_PID=
    fi

    pull_with_retry "$GITLAB_IMAGE:$ver"

    # shellcheck disable=SC2086
    docker run -d --name "$CONTAINER_NAME" $VOLUMES $PORTS "$GITLAB_IMAGE:$ver"

    wait_for_http_ready "$GITLAB_IMAGE:$ver"
    wait_for_healthy "$GITLAB_IMAGE:$ver"

    # 백그라운드 마이그레이션 완료 대기
    wait_for_background_migrations
    # 마이그레이션 상태 검증
    check_migration_status

    if [ $index -lt ${#UPGRADE_POINTS_ARRAY[@]} ]; then
        echo "gitlab-$GITLAB_EDITION $ver update completed. remaining jobs: $((${#UPGRADE_POINTS_ARRAY[@]} - index))"
    else
        echo "gitlab-$GITLAB_EDITION $ver update completed."
        send_discord_webhook "NOTE" "Upgrade process now completed!" "Please wait until GitLab server is ready."
    fi
    CNT_VERSION=$ver
    index=$((index + 1))
done

check_gitlab_server_healthy 1

# 최종 시크릿 무결성 확인
check_secrets_integrity "post-upgrade"

# 업그레이드 전 비활성화한 러너 복원
if [ -n "$PAUSED_RUNNER_IDS" ]; then
    id_list=$(echo "$PAUSED_RUNNER_IDS" | tr -s '[:space:]' ',' | sed 's/^,//;s/,$//')
    docker exec "$CONTAINER_NAME" gitlab-psql -c "UPDATE ci_runners SET active = true WHERE id IN ($id_list);" > /dev/null
    echo "Resumed previously paused runners: $id_list"
    send_discord_webhook "NOTE" "Runners resumed" "IDs: $id_list"
fi

exit_critical

# Interrupted 종료 처리 (RestartPolicy 변경, Discord NOTE는 정상 완료 시에만)
if [ "$_interrupted" -eq 1 ]; then
    echo "Upgrade was interrupted by user signal. Post-upgrade verification completed." >&2
    send_discord_webhook "WARN" "Upgrade interrupted" "User signal received during upgrade. Post-upgrade verification completed; current version: $CURRENT_VERSION"
    exit 130
fi

if [ "$auto_restart_enabled" == "$(docker inspect --format='{{.HostConfig.RestartPolicy.Name}}' "$CONTAINER_NAME")" ] && [ "$auto_restart_enabled" == 'no' ]; then
    if [ $auto_yes -eq 0 ]; then
        echo "Would you like to change RestartPolicy from $auto_restart_enabled to always?"
        echo 'AVAILABLE OPTIONS'
        echo -e 'no\t\t\t\tDo not automatically restart the container. (Default, Current)'
        echo -e 'on-failure[:max-retries]\tRestart the container if it exits due to an error, which manifests as a non-zero exit code.'
        echo -e 'always\t\t\t\tAlways restart the container if it stops. If it is manually stopped, it is restarted only when Docker daemon restarts or the container itself is manually restarted.'
        echo -e 'unless-stopped\t\t\tSimilar to always, except that when the container is stopped (manually or otherwise), it is not restarted even after Docker daemon restarts.'
        echo -n '> '
        read -r n < "$_tty"
        case "$n" in
            no|always|unless-stopped|on-failure|on-failure:[0-9]*)
                docker update --restart="$n" "$CONTAINER_NAME"
                ;;
            *)
                # shellcheck disable=SC2016
                echo 'If you want to edit RestartPolicy value later, please run `docker update --restart=<rule> <container-name>` to apply.'
                ;;
        esac
    fi
elif [ "$auto_restart_enabled" != "$(docker inspect --format='{{.HostConfig.RestartPolicy.Name}}' "$CONTAINER_NAME")" ]; then
    echo "Updating gitlab RestartPolicy from $(docker inspect --format='{{.HostConfig.RestartPolicy.Name}}' "$CONTAINER_NAME") to $auto_restart_enabled"
    docker update --restart="$auto_restart_enabled" "$CONTAINER_NAME" &> /dev/null
fi

echo "Successfully updated GitLab server from $CURRENT_VERSION to ${UPGRADE_POINTS_ARRAY[-1]}"
echo "Updated traceroute: ${UPGRADE_POINTS_ARRAY[*]}"
if [ -n "$max_tier_flag" ]; then
    max_tier=$max_tier_flag
elif [ "$GITLAB_EDITION" = "ce" ]; then
    max_tier=core
else
    max_tier=ultimate
fi
whats_new_url="https://gitlab-com.gitlab.io/cs-tools/gitlab-cs-tools/what-is-new-since/?tab=features&minVersion=${CURRENT_VERSION%%-*}&selectedMinTier=core&selectedMaxTier=${max_tier}&selectedSaaS=self-managed+only"
send_discord_webhook "NOTE" "Successfully upgraded GitLab server!" "GitLab version changed from [$CURRENT_VERSION to ${UPGRADE_POINTS_ARRAY[-1]}]($whats_new_url)"

exit 0
