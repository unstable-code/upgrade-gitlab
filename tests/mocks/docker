#!/usr/bin/env bash
# Mock docker CLI for BATS tests

MOCK_GITLAB_VERSION="${MOCK_GITLAB_VERSION:-16.11.0-ce.0}"

# State-based version tracking (for full-flow tests)
if [ -n "$MOCK_STATE_DIR" ] && [ -f "$MOCK_STATE_DIR/current_version" ]; then
    MOCK_GITLAB_VERSION=$(cat "$MOCK_STATE_DIR/current_version")
fi

MOCK_EDITION="${MOCK_GITLAB_VERSION##*-}"   # ce.0 or ee.0
MOCK_EDITION="${MOCK_EDITION%%.*}"          # ce or ee
MOCK_CONTAINER="gitlab"
MOCK_IMAGE="gitlab/gitlab-${MOCK_EDITION}:${MOCK_GITLAB_VERSION}"
# Derived images (#20): an official image plus local patches, named <anything>-patched:<tag>.
# MOCK_DERIVED_IMAGE=1 starts the container on one; after a `docker run`, the image it was
# given is what the container reports.
if [ "${MOCK_DERIVED_IMAGE:-0}" -eq 1 ]; then
    MOCK_IMAGE="gitlab-${MOCK_EDITION}-patched:${MOCK_GITLAB_VERSION}"
fi
if [ -n "$MOCK_STATE_DIR" ] && [ -f "$MOCK_STATE_DIR/current_image" ]; then
    MOCK_IMAGE=$(cat "$MOCK_STATE_DIR/current_image")
fi
MOCK_RUNNER_COUNT="${MOCK_RUNNER_COUNT:-0}"

# _mock_crash_before <key> <threshold>: true (=still "crashing") for the first <threshold>
# invocations keyed by <key>, then false. Used to simulate transient post-restart failures
# that recover after a few retries. Requires MOCK_STATE_DIR.
_mock_crash_before() {
    local key=$1 threshold=$2 f c=0
    [ -z "$threshold" ] && return 1
    [ -z "$MOCK_STATE_DIR" ] && return 1
    f="$MOCK_STATE_DIR/${key}_count"
    [ -f "$f" ] && c=$(cat "$f")
    c=$((c + 1)); echo "$c" > "$f"
    [ "$c" -le "$threshold" ]
}

# _mock_running_jobs_now: sets and prints _n, the number of CI jobs "running" right now.
# Every running-jobs query (count or listing) advances one shared counter, so the jobs
# finish after MOCK_RUNNING_JOBS_FINISH_AFTER queries; unset = they never finish.
_mock_running_jobs_now() {
    local c=0
    _n=${MOCK_RUNNING_JOBS:-0}
    if [ -n "$MOCK_STATE_DIR" ]; then
        [ -f "$MOCK_STATE_DIR/running_jobs_polls" ] && c=$(cat "$MOCK_STATE_DIR/running_jobs_polls")
        c=$((c + 1)); echo "$c" > "$MOCK_STATE_DIR/running_jobs_polls"
        if [ -n "${MOCK_RUNNING_JOBS_FINISH_AFTER:-}" ] && [ "$c" -gt "$MOCK_RUNNING_JOBS_FINISH_AFTER" ]; then
            _n=0
        fi
    fi
    echo "$_n"
}

# _mock_base_label: the base label a *-patched:<tag> image carries (gitlab/gitlab-<edition>:<tag>),
# empty for anything else.
_mock_base_label() {
    local tag ed
    [[ $1 == *-patched:* ]] || return 0
    tag=${1##*:}
    ed=${tag##*-}
    echo "gitlab/gitlab-${ed%%.*}:${tag}"
}

# The configuration the container was created from (#22): what the image put in, plus what the
# user added on top. MOCK_INSPECT_PATCH is a jq filter applied to the container JSON, so a test
# can add env, labels, networks, mounts or change the shm size without a fixture per case.
_mock_image_config() {
    jq -nc --arg base "$(_mock_base_label "$MOCK_IMAGE")" '{
        Env: ["PATH=/opt/gitlab/embedded/bin:/usr/bin", "LANG=C.UTF-8"],
        Labels: (if $base == "" then {} else {"org.upgrade-gitlab.base": $base} end),
        Cmd: ["/assets/wrapper"],
        Healthcheck: {Test: ["CMD", "/opt/gitlab/bin/gitlab-healthcheck"]},
        ExposedPorts: {"22/tcp": {}, "443/tcp": {}, "80/tcp": {}},
        Volumes: {"/etc/gitlab": {}, "/var/log/gitlab": {}, "/var/opt/gitlab": {}}
    }'
}

_mock_container_json() {
    local opts=${MOCK_LOG_OPTS:-}
    [ -n "$opts" ] || opts='{}'
    jq -c --arg img "$MOCK_IMAGE" --arg driver "${MOCK_LOG_DRIVER:-json-file}" \
        --argjson opts "$opts" '{
        Id: "0123456789abcdef0123456789abcdef",
        Name: "/gitlab",
        Image: "sha256:mockimage",
        Config: (. + {Hostname: "0123456789ab", Image: $img}),
        HostConfig: {
            Binds: ["/srv/gitlab/config:/etc/gitlab", "/srv/gitlab/logs:/var/log/gitlab", "/srv/gitlab/data:/var/opt/gitlab"],
            PortBindings: {"443/tcp": [{HostIp: "", HostPort: "443"}], "80/tcp": [{HostIp: "", HostPort: "80"}],
                           "22/tcp": [{HostIp: "", HostPort: "22"}]},
            LogConfig: {Type: $driver, Config: $opts},
            RestartPolicy: {Name: "unless-stopped", MaximumRetryCount: 0},
            NetworkMode: "bridge",
            IpcMode: "private",
            ShmSize: 268435456
        },
        Mounts: [
            {Type: "bind", Source: "/srv/gitlab/config", Destination: "/etc/gitlab", RW: true},
            {Type: "bind", Source: "/srv/gitlab/logs", Destination: "/var/log/gitlab", RW: true},
            {Type: "bind", Source: "/srv/gitlab/data", Destination: "/var/opt/gitlab", RW: true}
        ],
        NetworkSettings: {Networks: {bridge: {Aliases: null, NetworkID: "bridgenetid"}}}
    } | '"${MOCK_INSPECT_PATCH:-.}" <<<"$(_mock_image_config)"
}

args="$*"

case "$args" in
    "version --format {{.Server.Version}}")
        if [ -n "${MOCK_DOCKER_UNREACHABLE:-}" ]; then
            echo "permission denied while trying to connect to the docker API at unix:///var/run/docker.sock" >&2
            exit 1
        fi
        ;;
    "version --format {{.Server.APIVersion}}")
        echo "${MOCK_API_VERSION:-1.43}"
        ;;
    "context inspect --format {{.Endpoints.docker.Host}}")
        echo "${MOCK_DOCKER_ENDPOINT:-unix:///var/run/docker.sock}"
        ;;
    "container inspect --format {{json .}} "*)
        _mock_container_json
        ;;
    "image inspect --format {{json .Config}} "*)
        _mock_image_config
        ;;
    "ps -a --format {{.Image}}"*"{{.Names}}"*)
        echo -e "${MOCK_IMAGE}\t${MOCK_CONTAINER}"
        ;;
    "ps --format {{.Names}}"*)
        # A stopped/exited container is absent from `docker ps` (running-only).
        # MOCK_STATE_DIR/stopped marks that state; `docker start` clears it. This
        # exercises the start-stopped-container branch (crash-recovery) that the
        # always-running default would otherwise never reach.
        [ -n "$MOCK_STATE_DIR" ] && [ -f "$MOCK_STATE_DIR/stopped" ] || echo "$MOCK_CONTAINER"
        ;;
    "inspect ${MOCK_CONTAINER} --format={{.Config.Image}}"*|"inspect gitlab --format={{.Config.Image}}"*)
        echo "$MOCK_IMAGE"
        ;;
    *"inspect"*"Mounts"*)
        echo "/srv/gitlab/config:/etc/gitlab /srv/gitlab/logs:/var/log/gitlab /srv/gitlab/data:/var/opt/gitlab"
        ;;
    *"inspect"*"RestartPolicy"*)
        # Once the replacement has taken the name (`docker rename`), the container reports the
        # policy it was created with, until a `docker update --restart` changes it. Before that,
        # the original container's, from the same JSON `container inspect` returns.
        if [ -n "$MOCK_STATE_DIR" ] && [ -f "$MOCK_STATE_DIR/restart_policy" ]; then
            cat "$MOCK_STATE_DIR/restart_policy"
        elif [ -n "$MOCK_STATE_DIR" ] && [ -f "$MOCK_STATE_DIR/rename_args" ]; then
            tail -n1 "$MOCK_STATE_DIR/api_create" | jq -r .HostConfig.RestartPolicy.Name
        else
            _mock_container_json | jq -r .HostConfig.RestartPolicy.Name
        fi
        ;;
    "update --restart="*)
        if [ -n "$MOCK_STATE_DIR" ]; then
            printf '%s\n' "$args" >> "$MOCK_STATE_DIR/update_args"
            _p=${args#update --restart=}
            echo "${_p%% *}" > "$MOCK_STATE_DIR/restart_policy"
        fi
        exit 0
        ;;
    # Start time, for reading back the boot log with docker logs --since (#29).
    *"inspect"*"State.StartedAt"*)
        echo "2026-01-01T00:00:00.000000000Z"
        ;;
    # MOCK_HEALTH_STATUS: the Docker health status (default healthy); "none" = the image has no
    # HEALTHCHECK, which is what the script's format prints for an absent .State.Health.
    *"inspect"*"Health.Status"*)
        echo "${MOCK_HEALTH_STATUS:-healthy}"
        ;;
    *"inspect"*"NetworkSettings.Ports"*)
        echo "443/tcp -> 443 80/tcp -> 80 22/tcp -> 22"
        ;;
    # MOCK_RUNNING=false: the container has stopped (with MOCK_EXIT_CODE, default 0).
    *"inspect"*"State.Running"*)
        echo "${MOCK_RUNNING:-true} ${MOCK_EXIT_CODE:-0}"
        ;;
    *"inspect"*"ExitCode"*)
        echo "${MOCK_EXIT_CODE:-0}"
        ;;
    *"exec"*"dpkg -l"*)
        echo "ii  gitlab-${MOCK_EDITION}  ${MOCK_GITLAB_VERSION}  amd64  GitLab ${MOCK_EDITION^^}"
        ;;
    *"exec"*"custom_hooks_dir"*)
        # Pre-backup discovery of files outside /etc/gitlab (#26). MOCK_DATA_PATHS: newline-separated
        # paths it reports, as the tagged lines the script parses.
        [ -n "${MOCK_DATA_PATHS:-}" ] && printf 'path\t%s\n' $MOCK_DATA_PATHS
        # MOCK_FILE_HOOKS: file hooks present inside the container (#26 C), to archive.
        for _f in ${MOCK_FILE_HOOKS:-}; do printf 'path\t%s\n' "$_f"; done
        exit 0
        ;;
    *"exec"*"--dereference -rf"*)
        # Files outside /etc/gitlab appended to the configuration archive (#26). Records the paths;
        # MOCK_CONFIG_APPEND_FAIL=1 makes the append fail.
        [ -n "$MOCK_STATE_DIR" ] && printf '%s\n' "${@:8}" >> "$MOCK_STATE_DIR/config_append_args"
        [ "${MOCK_CONFIG_APPEND_FAIL:-0}" -eq 1 ] && { echo "tar: Cannot open: No space left on device" >&2; exit 1; }
        exit 0
        ;;
    *"exec"*"gitlab-ctl backup-etc"*)
        # Configuration volume archive (#26). Placed before the generic "sh -c" and "-t" cases:
        # the snippet carries `ls -t`. MOCK_CONFIG_BACKUP_FAIL=1: both backup-etc and the tar
        # fallback fail.
        if [ "${MOCK_CONFIG_BACKUP_FAIL:-0}" -eq 1 ]; then
            echo "tar: /etc/gitlab/config_backup: No space left on device" >&2
            exit 1
        fi
        echo "/etc/gitlab/config_backup/gitlab_config_1700000000_2026_01_01.tar"
        ;;
    # In-container backup liveness/stop for the cancel path. Placed early: "pgrep" contains
    # "grep", which the gitlab.rb grep patterns below would otherwise catch.
    *"exec"*"kill -TERM"*)
        # _stop_container_backup's single in-container stop-and-wait. MOCK_BACKUP_IGNORES_TERM=1
        # keeps the backup "running", which that loop reports as a timeout (exit 124).
        [ -n "$MOCK_STATE_DIR" ] && touch "$MOCK_STATE_DIR/backup_term_sent"
        if [ "${MOCK_BACKUP_IGNORES_TERM:-0}" -eq 1 ]; then exit 124; fi
        [ -n "$MOCK_STATE_DIR" ] && rm -f "$MOCK_STATE_DIR/backup_running"
        exit 0
        ;;
    *"exec"*"pgrep -f [g]itlab-ctl reconfigure"*)
        # The reconfigure the image runs at start (#29). Placed before the "gitlab-ctl reconfigure"
        # case, which this pattern would otherwise hit. MOCK_BOOT_RECONFIGURE_POLLS=N: still running
        # for the first N checks; "always": never finishes.
        [ "${MOCK_BOOT_RECONFIGURE_POLLS:-}" = always ] && exit 0
        _mock_crash_before boot_reconfigure "${MOCK_BOOT_RECONFIGURE_POLLS:-}" && exit 0
        exit 1
        ;;
    *"exec"*"pgrep -f gitlab[:]backup[:]create"*)
        # "Running" while the held gitlab-backup mock (MOCK_BACKUP_SLEEP) has its marker.
        if [ -n "$MOCK_STATE_DIR" ] && [ -f "$MOCK_STATE_DIR/backup_running" ]; then
            echo 4242
        else
            exit 1
        fi
        ;;
    *"exec"*"cat /etc/gitlab/gitlab.rb"*)
        echo "# gitlab.rb"
        ;;
    *"exec"*"grep"*"external_url"*)
        echo "external_url 'http://gitlab.test'"
        ;;
    *"exec"*"grep"*"backup_path"*)
        # MOCK_NO_BACKUP_PATH=1 → gitlab.rb has no backup_path line at all (grep finds nothing).
        if [ "${MOCK_NO_BACKUP_PATH:-0}" -eq 1 ]; then exit 1; fi
        echo "gitlab_rails['backup_path'] = \"/var/opt/gitlab/backups\""
        ;;
    # gitlab-psql: patterns must follow argument order in the expanded args string
    # e.g. "exec gitlab gitlab-psql -tAc SELECT COUNT(*) FROM ci_runners WHERE active = true;"
    #       → COUNT appears before ci_runners before active = true
    # Running CI jobs (#17). The count finishes after MOCK_RUNNING_JOBS_FINISH_AFTER queries
    # (the notice and the post-pause recount are queries too); unset = never finishes.
    *"exec"*"gitlab-psql"*"to_regclass"*)
        echo "${MOCK_CI_BUILDS_TABLE:-p_ci_builds}"
        ;;
    *"exec"*"gitlab-psql"*"EXTRACT(EPOCH"*"'canceling'"*)
        # The single running-jobs listing (count = lines): id|project|pipeline|name|status|running_seconds.
        _mock_running_jobs_now > /dev/null
        for _i in $(seq 1 "$_n"); do echo "50${_i}|group/app|77|deploy|running|192"; done
        ;;
    *"exec"*"gitlab-psql"*"information_schema"*)
        # MOCK_BBM_TABLE=missing → table genuinely absent (old GitLab); fail → psql error.
        case "${MOCK_BBM_TABLE:-present}" in
            missing) echo "f" ;;
            fail) exit 2 ;;
            *) echo "t" ;;
        esac
        ;;
    # Stuck migration detection query (uses INTERVAL clause).
    # Must come BEFORE the generic "job_class_name" pattern.
    *"exec"*"gitlab-psql"*"INTERVAL"*)
        if [ -n "${MOCK_STUCK_MIGRATIONS:-}" ]; then
            # Optional state-based "resolve after N polls" for interactive wait simulation.
            if [ -n "$MOCK_STATE_DIR" ] && [ -n "${MOCK_STUCK_RESOLVE_AFTER:-}" ]; then
                _count=0
                if [ -f "$MOCK_STATE_DIR/stuck_call_count" ]; then
                    _count=$(cat "$MOCK_STATE_DIR/stuck_call_count")
                fi
                _count=$((_count + 1))
                echo "$_count" > "$MOCK_STATE_DIR/stuck_call_count"
                if [ "$_count" -gt "${MOCK_STUCK_RESOLVE_AFTER}" ]; then
                    exit 0
                fi
            fi
            printf '%s\n' "$MOCK_STUCK_MIGRATIONS"
        fi
        ;;
    *"exec"*"gitlab-psql"*"job_class_name"*)
        echo ""
        ;;
    *"exec"*"gitlab-psql"*"status NOT IN"*)
        echo "0"
        ;;
    *"exec"*"gitlab-psql"*"COUNT"*"ci_runners"*"active = true"*)
        echo "$MOCK_RUNNER_COUNT"
        ;;
    *"exec"*"gitlab-psql"*"SELECT id"*"ci_runners"*"active = true"*)
        if [ "$MOCK_RUNNER_COUNT" -gt 0 ] 2>/dev/null; then
            printf '1\n2\n'
        fi
        ;;
    *"exec"*"gitlab-psql"*"COUNT"*"ci_runners"*)
        if [ "${MOCK_RUNNER_QUERY_FAIL:-0}" -eq 1 ]; then exit 1; fi
        echo "$MOCK_RUNNER_COUNT"
        ;;
    *"exec"*"gitlab-psql"*"UPDATE"*)
        exit 0
        ;;
    *"exec"*"gitlab-psql"*"ci_runners"*"ORDER BY"*)
        if [ "$MOCK_RUNNER_COUNT" -gt 0 ] 2>/dev/null; then
            echo " id | description | contacted_at | active"
            echo "----+-------------+--------------+--------"
            echo "  1 | runner-1    | 2024-01-01   | t"
            echo "  2 | runner-2    | 2024-01-01   | t"
        fi
        ;;
    *"exec"*"gitlab-psql"*"FROM lfs_objects"*)
        # Deduplicated on-disk LFS total. MOCK_LFS_DISK_FAIL=1 simulates an old
        # GitLab / permission error so the caller keeps the project_statistics value.
        [ -n "$MOCK_STATE_DIR" ] && touch "$MOCK_STATE_DIR/lfs_disk_query"
        if [ "${MOCK_LFS_DISK_FAIL:-0}" -eq 1 ]; then exit 1; fi
        echo "${MOCK_LFS_DISK_SIZE:-262144}"
        ;;
    *"exec"*"gitlab-psql"*"project_statistics"*)
        if [ "${MOCK_PSQL_STATS_FAIL:-0}" -eq 1 ]; then exit 1; fi
        echo "1048576|${MOCK_LFS_SIZE:-524288}|262144|131072|${MOCK_PROJECT_COUNT:-3}"
        ;;
    *"exec"*"gitlab-psql"*)
        exit 0
        ;;
    *"exec"*"which"*)
        exit 0
        ;;
    *"exec"*"gitlab-rails runner"*)
        # One line per rails boot, so tests can assert that snippets share a boot.
        [ -n "$MOCK_STATE_DIR" ] && echo x >> "$MOCK_STATE_DIR/rails_runner_calls"
        case "$args" in
            *"maintenance_mode: false"*)
                # Disable snippet. MOCK_MAINTENANCE_DISABLE_FAIL=1 → rails fails (no result line).
                [ -n "$MOCK_STATE_DIR" ] && touch "$MOCK_STATE_DIR/maintenance_disabled"
                if [ "${MOCK_MAINTENANCE_DISABLE_FAIL:-0}" -eq 1 ]; then exit 1; fi
                echo "maintenance_mode=disabled"
                exit 0
                ;;
        esac
        # --skip-object-storage detection: emit the object-storage-enabled resource
        # types from MOCK_OBJECT_STORAGE (space-separated), one per line, mimicking the
        # Gitlab.config probe. Empty/unset → no output → nothing gets skipped.
        case "$args" in
            *"object_store"*)
                for _t in ${MOCK_OBJECT_STORAGE:-}; do echo "$_t"; done
                ;;
        esac
        # Enable snippet. MOCK_MAINTENANCE: enabled | already | unavailable (default) | error;
        # "fail" prints nothing, as when rails cannot boot.
        case "$args" in
            *"maintenance_mode: true"*)
                [ -n "$MOCK_STATE_DIR" ] && touch "$MOCK_STATE_DIR/maintenance_probe"
                # MOCK_RAILS_SLEEP: hold inside the boot (minutes in reality) so a test can
                # deliver a signal while the enable is still in flight.
                if [ -n "${MOCK_RAILS_SLEEP:-}" ]; then sleep "$MOCK_RAILS_SLEEP"; fi
                [ "${MOCK_MAINTENANCE:-}" = fail ] || echo "maintenance_mode=${MOCK_MAINTENANCE:-unavailable}"
                ;;
        esac
        exit 0
        ;;
    *"exec"*"-t"*"gitlab-backup"*)
        # Record the full arg string so tests can assert on the passed SKIP= value.
        [ -n "$MOCK_STATE_DIR" ] && echo "$args" > "$MOCK_STATE_DIR/backup_args"
        # -t flag backup (progress bar path)
        echo "2026-01-01 00:00:00 UTC -- Dumping database ... done"
        echo "2026-01-01 00:00:00 UTC -- Dumping repositories ..."
        for i in $(seq 1 "${MOCK_PROJECT_COUNT:-3}"); do
            echo "{\"command.name\":\"create\",\"gl_project_path\":\"root/project-${i}\",\"msg\":\"completed create\"}"
        done
        echo "2026-01-01 00:00:00 UTC -- Dumping repositories ... done"
        echo "2026-01-01 00:00:00 UTC -- Dumping lfs objects ... done"
        echo "2026-01-01 00:00:00 UTC -- Dumping uploads ... done"
        echo "2026-01-01 00:00:00 UTC -- Dumping builds ... done"
        # MOCK_PACK_SLEEP: linger inside the pack stage so run_with_progress_bar's
        # polling loop actually samples it (otherwise the mock exits before a tick).
        echo "2026-01-01 00:00:00 UTC -- Creating backup archive: ${MOCK_BACKUP_TAR_NAME:-1700000000_2026_01_01_16.11.0-ce_gitlab_backup.tar} ... "
        [ -n "${MOCK_PACK_SLEEP:-}" ] && sleep "$MOCK_PACK_SLEEP"
        # MOCK_BACKUP_FAIL=1: a target failed — gitlab-backup finishes the rest, then exits 1.
        if [ "${MOCK_BACKUP_FAIL:-0}" -eq 1 ]; then
            echo "2026-01-01 00:00:00 UTC -- Dumping uploads failed: mock failure"
            exit 1
        fi
        echo "2026-01-01 00:00:00 UTC -- Creating backup archive: ${MOCK_BACKUP_TAR_NAME:-1700000000_2026_01_01_16.11.0-ce_gitlab_backup.tar} ... done"
        exit 0
        ;;
    *"exec"*"gitlab-backup"*)
        # MOCK_BACKUP_SLEEP: hold inside the backup so a test can deliver a signal
        # mid-backup (after runners are paused, before the critical zone). The marker
        # file lets the test wait deterministically instead of racing on a fixed sleep.
        # backup_running mirrors the in-container process that pgrep would find.
        if [ -n "${MOCK_BACKUP_SLEEP:-}" ]; then
            [ -n "$MOCK_STATE_DIR" ] && touch "$MOCK_STATE_DIR/backup_started" "$MOCK_STATE_DIR/backup_running"
            sleep "$MOCK_BACKUP_SLEEP"
            [ -n "$MOCK_STATE_DIR" ] && rm -f "$MOCK_STATE_DIR/backup_running"
        fi
        if [ "${MOCK_BACKUP_FAIL:-0}" -eq 1 ]; then exit 1; fi
        exit 0
        ;;
    *"exec"*"gitlab-ctl reconfigure"*)
        echo "Recipe: gitlab::default"
        echo "  * execute[reload nginx] action run (skipped due to only_if)"
        # MOCK_DEPRECATIONS (newline-separated) reproduces Chef's trailing
        # "Deprecations:" block so the end-of-run summary can be asserted on.
        if [ -n "${MOCK_DEPRECATIONS:-}" ]; then
            echo ''
            echo 'Deprecations:'
            printf '%s\n' "$MOCK_DEPRECATIONS"
            echo ''
        fi
        echo 'Running handlers complete'
        exit 0
        ;;
    *"exec"*"gitlab-ctl restart"*)
        exit 0
        ;;
    *"exec"*"gitlab-ctl pg-upgrade"*)
        exit 0
        ;;
    *"exec"*"gitlab-ctl status"*)
        if _mock_crash_before ctl_status "${MOCK_CTL_STATUS_CRASH_BEFORE:-}"; then
            echo "run: puma: (pid 0) not running" >&2
            exit 1
        fi
        exit 0
        ;;
    *"exec"*"gitlab-rake"*"db:migrate:status"*)
        if _mock_crash_before migrate_status "${MOCK_MIGRATE_STATUS_CRASH_BEFORE:-}"; then
            # task failed to boot → no status table (up/down rows) in output
            echo "rails aborted! ActiveRecord::ConnectionNotEstablished"
            exit 1
        fi
        echo "  up  20240101  TestMigration"
        ;;
    *"exec"*"gitlab-rake"*"gitlab:doctor:secrets"*)
        # MOCK_SECRETS=ok|bad ; MOCK_SECRETS_CRASH_BEFORE=N (state-counted) makes the first N
        # invocations exit non-zero WITHOUT "Done!" (restart-window transient), then succeed —
        # exercises check_secrets_integrity's retry-until-complete path.
        if [ -n "$MOCK_STATE_DIR" ] && [ -n "${MOCK_SECRETS_CRASH_BEFORE:-}" ]; then
            _sc=0
            [ -f "$MOCK_STATE_DIR/secrets_call_count" ] && _sc=$(cat "$MOCK_STATE_DIR/secrets_call_count")
            _sc=$((_sc + 1))
            echo "$_sc" > "$MOCK_STATE_DIR/secrets_call_count"
            if [ "$_sc" -le "${MOCK_SECRETS_CRASH_BEFORE}" ]; then
                echo "rails aborted! PG::ConnectionBad: could not connect to server: Connection refused"
                exit 1
            fi
        fi
        # Real GitLab behavior: doctor:secrets logs failures but ALWAYS exits 0 + prints "Done!".
        # Integrity is judged from the "Total: N row(s) affected" line, not the exit code.
        case "${MOCK_SECRETS:-ok}" in
            bad)
                echo "I, [ts #1]  INFO -- : - User failures: 2"
                echo "I, [ts #1]  INFO -- : Total: 2 row(s) affected"
                echo "I, [ts #1]  INFO -- : Done!"
                exit 0
                ;;
            *)
                echo "I, [ts #1]  INFO -- : Total: 0 row(s) affected"
                echo "I, [ts #1]  INFO -- : Done!"
                exit 0
                ;;
        esac
        ;;
    *"exec"*"gitlab-rake"*)
        exit 0
        ;;
    *"exec"*"gitlab-healthcheck-rc"*)
        # HTTP readiness (#24): run the in-container snippet here, against
        # MOCK_HEALTHCHECK_RC (unset = no rc, as on an old version or before reconfigure).
        # Its curl reaches the curl mock, which MOCK_READY_URL can restrict to one address.
        bash -c "$5" _ "${MOCK_HEALTHCHECK_RC:-/nonexistent}"
        ;;
    *"exec"*"sh -c"*"du -sb"*)
        # staging total: denominator for the "Creating backup archive" progress bar
        if [ "${MOCK_PACK_TOTAL_FAIL:-0}" -eq 1 ]; then exit 1; fi
        echo "${MOCK_PACK_TOTAL:-1000000}"
        exit 0
        ;;
    *"exec"*"sh -c"*"stat"*"tar.gz"*)
        echo "0 /var/opt/gitlab/backups/dummy.tar.gz"
        echo "${MOCK_BACKUP_TAR_SIZE:-500000} /var/opt/gitlab/backups/${MOCK_BACKUP_TAR_NAME:-1700000000_2026_01_01_16.11.0-ce_gitlab_backup.tar}"
        echo "---"
        exit 0
        ;;
    *"exec"*"sh -c"*)
        exit 0
        ;;
    # Subcommand cases are anchored at the start (#19): a bare *"run"* or *"stop"* also matched
    # `/var/run`, `gitlab-runner` or `gitlab-ctl stop` anywhere in the args. The compound
    # *"exec"*/*"inspect"* patterns above are still unanchored, so they keep their ordering notes.
    "image inspect -f {{range .RepoTags}}"*)
        # "<RepoTags>|<base label>" in one call. RepoTags answer MOCK_IMAGE like the plain
        # `image inspect` below. The label: a *-patched:<tag> image carries
        # gitlab/gitlab-<edition>:<tag>, anything else has none. The image is the last argument.
        echo "${MOCK_IMAGE} |$(_mock_base_label "${args##* }")"
        ;;
    "image inspect "*)
        echo "$MOCK_IMAGE"
        ;;
    "rename "*)
        # MOCK_RENAME_FAIL=1: the replacement cannot take the name after the original is removed.
        [ "${MOCK_RENAME_FAIL:-0}" -eq 1 ] && exit 1
        # The replacement container (created through the API mock in curl) takes the real name:
        # from here on its image is what the container runs, and its tag the version.
        if [ -n "$MOCK_STATE_DIR" ]; then
            printf '%s\n' "$args" >> "$MOCK_STATE_DIR/rename_args"
            if [ -f "$MOCK_STATE_DIR/created_image" ]; then
                _img=$(cat "$MOCK_STATE_DIR/created_image")
                echo "${_img##*:}" > "$MOCK_STATE_DIR/current_version"
                echo "$_img" > "$MOCK_STATE_DIR/current_image"
            fi
        fi
        exit 0
        ;;
    "pull "*)
        # MOCK_PULL_FAIL=1: the registry is unreachable.
        if [ "${MOCK_PULL_FAIL:-0}" -eq 1 ]; then exit 1; fi
        exit 0
        ;;
    "image rm "*)
        [ -n "$MOCK_STATE_DIR" ] && printf '%s\n' "${args#image rm }" >> "$MOCK_STATE_DIR/image_rm_args"
        exit 0
        ;;
    "start "*)
        # Starting clears the stopped marker so later `docker ps` shows it running.
        [ -n "$MOCK_STATE_DIR" ] && rm -f "$MOCK_STATE_DIR/stopped"
        exit 0
        ;;
    "stop "*)
        # Record `docker stop` invocations so tests can assert on the grace period.
        if [ -n "$MOCK_STATE_DIR" ]; then
            printf '%s\n' "$args" >> "$MOCK_STATE_DIR/stop_args"
        fi
        exit 0
        ;;
    "diff "*)
        # MOCK_ADDED_FILE_HOOKS: file hooks in the writable layer, i.e. added after the container was
        # created, which a hop drops (#26 C).
        for _f in ${MOCK_ADDED_FILE_HOOKS:-}; do echo "A $_f"; done
        exit 0
        ;;
    "cp "*)
        # docker cp: records "<src> <dest>"; the source is a host temp file the script removes
        # right after, so its content is kept as cp_content.
        if [ -n "$MOCK_STATE_DIR" ]; then
            printf '%s\n' "$2 $3" >> "$MOCK_STATE_DIR/cp_args"
            [ -f "$2" ] && cp "$2" "$MOCK_STATE_DIR/cp_content"
        fi
        exit 0
        ;;
    "logs "*)
        # MOCK_LOGS lets tests feed container log content to print_stacktrace_errors.
        [ -n "${MOCK_LOGS:-}" ] && printf '%s\n' "$MOCK_LOGS"
        # MOCK_BOOT_DEPRECATIONS: the "Deprecations:" block of the reconfigure the image runs at
        # start (#29), read back with --since <StartedAt>.
        if [[ "$args" == *"--since "* ]] && [ -n "${MOCK_BOOT_DEPRECATIONS:-}" ]; then
            printf '\nDeprecations:\n%s\n\nRunning handlers complete\n' "$MOCK_BOOT_DEPRECATIONS"
        fi
        exit 0
        ;;
    # container rm, plain container inspect and anything else: accepted, no output.
    *)
        exit 0
        ;;
esac
