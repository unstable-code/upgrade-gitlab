#!/usr/bin/env bash
# Mock docker CLI for BATS tests

MOCK_GITLAB_VERSION="${MOCK_GITLAB_VERSION:-16.11.0-ce.0}"

# State-based version tracking (for full-flow tests)
if [ -n "$MOCK_STATE_DIR" ] && [ -f "$MOCK_STATE_DIR/current_version" ]; then
    MOCK_GITLAB_VERSION=$(cat "$MOCK_STATE_DIR/current_version")
fi

MOCK_EDITION="${MOCK_GITLAB_VERSION##*-}"   # ce.0 or ee.0
MOCK_EDITION="${MOCK_EDITION%%.*}"          # ce or ee
MOCK_CONTAINER="gitlab"
MOCK_IMAGE="gitlab/gitlab-${MOCK_EDITION}:${MOCK_GITLAB_VERSION}"
MOCK_RUNNER_COUNT="${MOCK_RUNNER_COUNT:-0}"

# _mock_crash_before <key> <threshold>: true (=still "crashing") for the first <threshold>
# invocations keyed by <key>, then false. Used to simulate transient post-restart failures
# that recover after a few retries. Requires MOCK_STATE_DIR.
_mock_crash_before() {
    local key=$1 threshold=$2 f c=0
    [ -z "$threshold" ] && return 1
    [ -z "$MOCK_STATE_DIR" ] && return 1
    f="$MOCK_STATE_DIR/${key}_count"
    [ -f "$f" ] && c=$(cat "$f")
    c=$((c + 1)); echo "$c" > "$f"
    [ "$c" -le "$threshold" ]
}

args="$*"

case "$args" in
    "ps -a --format {{.Image}}"*"{{.Names}}"*)
        echo -e "${MOCK_IMAGE}\t${MOCK_CONTAINER}"
        ;;
    "ps --format {{.Names}}"*)
        # A stopped/exited container is absent from `docker ps` (running-only).
        # MOCK_STATE_DIR/stopped marks that state; `docker start` clears it. This
        # exercises the start-stopped-container branch (crash-recovery) that the
        # always-running default would otherwise never reach.
        [ -n "$MOCK_STATE_DIR" ] && [ -f "$MOCK_STATE_DIR/stopped" ] || echo "$MOCK_CONTAINER"
        ;;
    "inspect ${MOCK_CONTAINER} --format={{.Config.Image}}"*|"inspect gitlab --format={{.Config.Image}}"*)
        echo "$MOCK_IMAGE"
        ;;
    *"inspect"*"Mounts"*)
        echo "/srv/gitlab/config:/etc/gitlab /srv/gitlab/logs:/var/log/gitlab /srv/gitlab/data:/var/opt/gitlab"
        ;;
    *"inspect"*"PortBindings"*)
        echo "443/tcp:443 80/tcp:80 22/tcp:22"
        ;;
    *"inspect"*"LogConfig.Type"*)
        # MOCK_LOG_DRIVER lets tests exercise the Synology 'db' replacement branch.
        echo "${MOCK_LOG_DRIVER:-json-file}"
        ;;
    *"inspect"*"LogConfig.Config"*)
        printf '%s\n' "${MOCK_LOG_OPTS:-}"
        ;;
    *"inspect"*"RestartPolicy"*)
        echo "unless-stopped"
        ;;
    *"inspect"*"Health.Status"*)
        echo "healthy"
        ;;
    *"inspect"*"NetworkSettings.Ports"*)
        echo "443/tcp -> 443 80/tcp -> 80 22/tcp -> 22"
        ;;
    *"inspect"*"ExitCode"*)
        echo "${MOCK_EXIT_CODE:-0}"
        ;;
    *"exec"*"dpkg -l"*)
        echo "ii  gitlab-${MOCK_EDITION}  ${MOCK_GITLAB_VERSION}  amd64  GitLab ${MOCK_EDITION^^}"
        ;;
    *"exec"*"cat /etc/gitlab/gitlab.rb"*)
        echo "# gitlab.rb"
        ;;
    *"exec"*"grep"*"external_url"*)
        echo "external_url 'http://gitlab.test'"
        ;;
    *"exec"*"grep"*"backup_path"*)
        # MOCK_NO_BACKUP_PATH=1 → gitlab.rb has no backup_path line at all (grep finds nothing).
        if [ "${MOCK_NO_BACKUP_PATH:-0}" -eq 1 ]; then exit 1; fi
        echo "gitlab_rails['backup_path'] = \"/var/opt/gitlab/backups\""
        ;;
    # gitlab-psql: patterns must follow argument order in the expanded args string
    # e.g. "exec gitlab gitlab-psql -tAc SELECT COUNT(*) FROM ci_runners WHERE active = true;"
    #       → COUNT appears before ci_runners before active = true
    *"exec"*"gitlab-psql"*"information_schema"*)
        # MOCK_BBM_TABLE=missing → table genuinely absent (old GitLab); fail → psql error.
        case "${MOCK_BBM_TABLE:-present}" in
            missing) echo "f" ;;
            fail) exit 2 ;;
            *) echo "t" ;;
        esac
        ;;
    # Stuck migration detection query (uses INTERVAL clause).
    # Must come BEFORE the generic "job_class_name" pattern.
    *"exec"*"gitlab-psql"*"INTERVAL"*)
        if [ -n "${MOCK_STUCK_MIGRATIONS:-}" ]; then
            # Optional state-based "resolve after N polls" for interactive wait simulation.
            if [ -n "$MOCK_STATE_DIR" ] && [ -n "${MOCK_STUCK_RESOLVE_AFTER:-}" ]; then
                _count=0
                if [ -f "$MOCK_STATE_DIR/stuck_call_count" ]; then
                    _count=$(cat "$MOCK_STATE_DIR/stuck_call_count")
                fi
                _count=$((_count + 1))
                echo "$_count" > "$MOCK_STATE_DIR/stuck_call_count"
                if [ "$_count" -gt "${MOCK_STUCK_RESOLVE_AFTER}" ]; then
                    exit 0
                fi
            fi
            printf '%s\n' "$MOCK_STUCK_MIGRATIONS"
        fi
        ;;
    *"exec"*"gitlab-psql"*"job_class_name"*)
        echo ""
        ;;
    *"exec"*"gitlab-psql"*"status NOT IN"*)
        echo "0"
        ;;
    *"exec"*"gitlab-psql"*"COUNT"*"ci_runners"*"active = true"*)
        echo "$MOCK_RUNNER_COUNT"
        ;;
    *"exec"*"gitlab-psql"*"SELECT id"*"ci_runners"*"active = true"*)
        if [ "$MOCK_RUNNER_COUNT" -gt 0 ] 2>/dev/null; then
            printf '1\n2\n'
        fi
        ;;
    *"exec"*"gitlab-psql"*"COUNT"*"ci_runners"*)
        if [ "${MOCK_RUNNER_QUERY_FAIL:-0}" -eq 1 ]; then exit 1; fi
        echo "$MOCK_RUNNER_COUNT"
        ;;
    *"exec"*"gitlab-psql"*"UPDATE"*)
        exit 0
        ;;
    *"exec"*"gitlab-psql"*"ci_runners"*"ORDER BY"*)
        if [ "$MOCK_RUNNER_COUNT" -gt 0 ] 2>/dev/null; then
            echo " id | description | contacted_at | active"
            echo "----+-------------+--------------+--------"
            echo "  1 | runner-1    | 2024-01-01   | t"
            echo "  2 | runner-2    | 2024-01-01   | t"
        fi
        ;;
    *"exec"*"gitlab-psql"*"FROM lfs_objects"*)
        # Deduplicated on-disk LFS total. MOCK_LFS_DISK_FAIL=1 simulates an old
        # GitLab / permission error so the caller keeps the project_statistics value.
        [ -n "$MOCK_STATE_DIR" ] && touch "$MOCK_STATE_DIR/lfs_disk_query"
        if [ "${MOCK_LFS_DISK_FAIL:-0}" -eq 1 ]; then exit 1; fi
        echo "${MOCK_LFS_DISK_SIZE:-262144}"
        ;;
    *"exec"*"gitlab-psql"*"project_statistics"*)
        if [ "${MOCK_PSQL_STATS_FAIL:-0}" -eq 1 ]; then exit 1; fi
        echo "1048576|${MOCK_LFS_SIZE:-524288}|262144|131072|${MOCK_PROJECT_COUNT:-3}"
        ;;
    *"exec"*"gitlab-psql"*)
        exit 0
        ;;
    *"exec"*"which"*)
        exit 0
        ;;
    *"exec"*"gitlab-rails runner"*)
        # One line per rails boot, so tests can assert that snippets share a boot.
        [ -n "$MOCK_STATE_DIR" ] && echo x >> "$MOCK_STATE_DIR/rails_runner_calls"
        case "$args" in
            *"maintenance_mode: false"*)
                # Disable snippet. MOCK_MAINTENANCE_DISABLE_FAIL=1 → rails fails (no result line).
                [ -n "$MOCK_STATE_DIR" ] && touch "$MOCK_STATE_DIR/maintenance_disabled"
                if [ "${MOCK_MAINTENANCE_DISABLE_FAIL:-0}" -eq 1 ]; then exit 1; fi
                echo "maintenance_mode=disabled"
                exit 0
                ;;
        esac
        # --skip-object-storage detection: emit the object-storage-enabled resource
        # types from MOCK_OBJECT_STORAGE (space-separated), one per line, mimicking the
        # Gitlab.config probe. Empty/unset → no output → nothing gets skipped.
        case "$args" in
            *"object_store"*)
                for _t in ${MOCK_OBJECT_STORAGE:-}; do echo "$_t"; done
                ;;
        esac
        # Enable snippet. MOCK_MAINTENANCE: enabled | already | unavailable (default) | error;
        # "fail" prints nothing, as when rails cannot boot.
        case "$args" in
            *"maintenance_mode: true"*)
                [ -n "$MOCK_STATE_DIR" ] && touch "$MOCK_STATE_DIR/maintenance_probe"
                # MOCK_RAILS_SLEEP: hold inside the boot (minutes in reality) so a test can
                # deliver a signal while the enable is still in flight.
                if [ -n "${MOCK_RAILS_SLEEP:-}" ]; then sleep "$MOCK_RAILS_SLEEP"; fi
                [ "${MOCK_MAINTENANCE:-}" = fail ] || echo "maintenance_mode=${MOCK_MAINTENANCE:-unavailable}"
                ;;
        esac
        exit 0
        ;;
    *"exec"*"-t"*"gitlab-backup"*)
        # Record the full arg string so tests can assert on the passed SKIP= value.
        [ -n "$MOCK_STATE_DIR" ] && echo "$args" > "$MOCK_STATE_DIR/backup_args"
        # -t flag backup (progress bar path)
        echo "2026-01-01 00:00:00 UTC -- Dumping database ... done"
        echo "2026-01-01 00:00:00 UTC -- Dumping repositories ..."
        for i in $(seq 1 "${MOCK_PROJECT_COUNT:-3}"); do
            echo "{\"command.name\":\"create\",\"gl_project_path\":\"root/project-${i}\",\"msg\":\"completed create\"}"
        done
        echo "2026-01-01 00:00:00 UTC -- Dumping repositories ... done"
        echo "2026-01-01 00:00:00 UTC -- Dumping lfs objects ... done"
        echo "2026-01-01 00:00:00 UTC -- Dumping uploads ... done"
        echo "2026-01-01 00:00:00 UTC -- Dumping builds ... done"
        # MOCK_PACK_SLEEP: linger inside the pack stage so run_with_progress_bar's
        # polling loop actually samples it (otherwise the mock exits before a tick).
        echo "2026-01-01 00:00:00 UTC -- Creating backup archive: ${MOCK_BACKUP_TAR_NAME:-1700000000_2026_01_01_16.11.0-ce_gitlab_backup.tar} ... "
        [ -n "${MOCK_PACK_SLEEP:-}" ] && sleep "$MOCK_PACK_SLEEP"
        echo "2026-01-01 00:00:00 UTC -- Creating backup archive: ${MOCK_BACKUP_TAR_NAME:-1700000000_2026_01_01_16.11.0-ce_gitlab_backup.tar} ... done"
        exit 0
        ;;
    *"exec"*"gitlab-backup"*)
        # MOCK_BACKUP_SLEEP: hold inside the backup so a test can deliver a signal
        # mid-backup (after runners are paused, before the critical zone). The marker
        # file lets the test wait deterministically instead of racing on a fixed sleep.
        if [ -n "${MOCK_BACKUP_SLEEP:-}" ]; then
            [ -n "$MOCK_STATE_DIR" ] && touch "$MOCK_STATE_DIR/backup_started"
            sleep "$MOCK_BACKUP_SLEEP"
        fi
        exit 0
        ;;
    *"exec"*"gitlab-ctl reconfigure"*)
        echo "Recipe: gitlab::default"
        echo "  * execute[reload nginx] action run (skipped due to only_if)"
        # MOCK_DEPRECATIONS (newline-separated) reproduces Chef's trailing
        # "Deprecations:" block so the end-of-run summary can be asserted on.
        if [ -n "${MOCK_DEPRECATIONS:-}" ]; then
            echo ''
            echo 'Deprecations:'
            printf '%s\n' "$MOCK_DEPRECATIONS"
            echo ''
        fi
        echo 'Running handlers complete'
        exit 0
        ;;
    *"exec"*"gitlab-ctl restart"*)
        exit 0
        ;;
    *"exec"*"gitlab-ctl pg-upgrade"*)
        exit 0
        ;;
    *"exec"*"gitlab-ctl status"*)
        if _mock_crash_before ctl_status "${MOCK_CTL_STATUS_CRASH_BEFORE:-}"; then
            echo "run: puma: (pid 0) not running" >&2
            exit 1
        fi
        exit 0
        ;;
    *"exec"*"gitlab-rake"*"db:migrate:status"*)
        if _mock_crash_before migrate_status "${MOCK_MIGRATE_STATUS_CRASH_BEFORE:-}"; then
            # task failed to boot → no status table (up/down rows) in output
            echo "rails aborted! ActiveRecord::ConnectionNotEstablished"
            exit 1
        fi
        echo "  up  20240101  TestMigration"
        ;;
    *"exec"*"gitlab-rake"*"gitlab:doctor:secrets"*)
        # MOCK_SECRETS=ok|bad ; MOCK_SECRETS_CRASH_BEFORE=N (state-counted) makes the first N
        # invocations exit non-zero WITHOUT "Done!" (restart-window transient), then succeed —
        # exercises check_secrets_integrity's retry-until-complete path.
        if [ -n "$MOCK_STATE_DIR" ] && [ -n "${MOCK_SECRETS_CRASH_BEFORE:-}" ]; then
            _sc=0
            [ -f "$MOCK_STATE_DIR/secrets_call_count" ] && _sc=$(cat "$MOCK_STATE_DIR/secrets_call_count")
            _sc=$((_sc + 1))
            echo "$_sc" > "$MOCK_STATE_DIR/secrets_call_count"
            if [ "$_sc" -le "${MOCK_SECRETS_CRASH_BEFORE}" ]; then
                echo "rails aborted! PG::ConnectionBad: could not connect to server: Connection refused"
                exit 1
            fi
        fi
        # Real GitLab behavior: doctor:secrets logs failures but ALWAYS exits 0 + prints "Done!".
        # Integrity is judged from the "Total: N row(s) affected" line, not the exit code.
        case "${MOCK_SECRETS:-ok}" in
            bad)
                echo "I, [ts #1]  INFO -- : - User failures: 2"
                echo "I, [ts #1]  INFO -- : Total: 2 row(s) affected"
                echo "I, [ts #1]  INFO -- : Done!"
                exit 0
                ;;
            *)
                echo "I, [ts #1]  INFO -- : Total: 0 row(s) affected"
                echo "I, [ts #1]  INFO -- : Done!"
                exit 0
                ;;
        esac
        ;;
    *"exec"*"gitlab-rake"*)
        exit 0
        ;;
    *"exec"*"curl"*)
        echo "200"
        exit 0
        ;;
    *"exec"*"sh -c"*"du -sb"*)
        # staging total: denominator for the "Creating backup archive" progress bar
        if [ "${MOCK_PACK_TOTAL_FAIL:-0}" -eq 1 ]; then exit 1; fi
        echo "${MOCK_PACK_TOTAL:-1000000}"
        exit 0
        ;;
    *"exec"*"sh -c"*"stat"*"tar.gz"*)
        echo "0 /var/opt/gitlab/backups/dummy.tar.gz"
        echo "${MOCK_BACKUP_TAR_SIZE:-500000} /var/opt/gitlab/backups/${MOCK_BACKUP_TAR_NAME:-1700000000_2026_01_01_16.11.0-ce_gitlab_backup.tar}"
        echo "---"
        exit 0
        ;;
    *"exec"*"sh -c"*)
        exit 0
        ;;
    *"image inspect"*)
        echo "$MOCK_IMAGE"
        ;;
    *"run"*)
        # Update state file with new version tag for full-flow simulation
        if [ -n "$MOCK_STATE_DIR" ]; then
            # Record `docker run` invocations so tests can assert on the flags passed.
            case "$args" in
                "run "*) printf '%s\n' "$args" >> "$MOCK_STATE_DIR/run_args" ;;
            esac
            _tag=$(echo "$args" | sed -n 's/.*gitlab\/gitlab-[^:]*:\([^ ]*\).*/\1/p')
            if [ -n "$_tag" ]; then
                echo "$_tag" > "$MOCK_STATE_DIR/current_version"
            fi
        fi
        exit 0
        ;;
    *"update"*)
        exit 0
        ;;
    *"container rm"*)
        exit 0
        ;;
    *"image rm"*)
        exit 0
        ;;
    *"start"*)
        # Starting clears the stopped marker so later `docker ps` shows it running.
        [ -n "$MOCK_STATE_DIR" ] && rm -f "$MOCK_STATE_DIR/stopped"
        exit 0
        ;;
    *"stop"*)
        # Record `docker stop` invocations so tests can assert on the grace period.
        if [ -n "$MOCK_STATE_DIR" ]; then
            printf '%s\n' "$args" >> "$MOCK_STATE_DIR/stop_args"
        fi
        exit 0
        ;;
    *"rm"*)
        exit 0
        ;;
    *"pull"*)
        exit 0
        ;;
    *"logs"*)
        # MOCK_LOGS lets tests feed container log content to print_stacktrace_errors.
        [ -n "${MOCK_LOGS:-}" ] && printf '%s\n' "$MOCK_LOGS"
        exit 0
        ;;
    *)
        exit 0
        ;;
esac
