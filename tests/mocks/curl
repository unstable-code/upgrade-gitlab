#!/usr/bin/env bash
# Mock curl for BATS tests
# Handles: path.json, Docker Hub API, Docker Engine API (unix socket), generic URLs

FIXTURES_DIR="${FIXTURES_DIR:-$(cd "$(dirname "$0")/../fixtures" && pwd)}"

# Parse curl arguments to find URL and flags
url=""
write_out=""
socket=""
body=""
skip_next=""
for arg in "$@"; do
    if [ -n "$skip_next" ]; then
        case "$skip_next" in
            w) case "$arg" in *http_code*) write_out="http_code" ;; esac ;;
            socket) socket=$arg ;;
            body) body=$arg ;;
        esac
        skip_next=""
        continue
    fi
    case "$arg" in
        -s|-f|-sf|-fs) ;;
        -o) skip_next="skip" ;;
        -w) skip_next="w" ;;
        -d|-H|-X) skip_next="skip" ;;
        --unix-socket) skip_next="socket" ;;
        --data-binary) skip_next="body" ;;
        http*) url="$arg" ;;
    esac
done

# Docker Engine API over the unix socket (#22): container create and network connect.
# The script reads the body and then the HTTP status from stdout (`-w '\n%{http_code}'`).
# Each request body is appended to MOCK_STATE_DIR/api_<create|connect> as one JSON line.
# The created image only becomes the running one at `docker rename` (see the docker mock).
if [ -n "$socket" ]; then
    _respond() { printf '%s\n%s' "$2" "$1"; }
    case "$url" in
        */_ping)
            if [ "${MOCK_API_UNREACHABLE:-0}" -eq 1 ]; then
                echo "curl: (7) Couldn't connect to server" >&2
                exit 7
            fi
            echo -n OK
            ;;
        */containers/create\?name=*)
            if [ "${MOCK_CREATE_FAIL:-0}" -eq 1 ]; then
                _respond 400 '{"message":"mock create rejected"}'
                exit 0
            fi
            if [ -n "$MOCK_STATE_DIR" ]; then
                jq -c . <<<"$body" >> "$MOCK_STATE_DIR/api_create"
                jq -r .Image <<<"$body" > "$MOCK_STATE_DIR/created_image"
            fi
            _respond 201 '{"Id":"fedcba9876543210","Warnings":[]}'
            ;;
        */networks/*/connect)
            [ -n "$MOCK_STATE_DIR" ] && jq -c --arg url "$url" '. + {url: $url}' <<<"$body" >> "$MOCK_STATE_DIR/api_connect"
            _respond 200 ''
            ;;
        *)
            _respond 404 '{"message":"mock: unknown endpoint"}'
            ;;
    esac
    exit 0
fi

case "$url" in
    *"path.json"*)
        if [ "${MOCK_PATH_JSON_FAIL:-0}" -eq 1 ]; then
            exit 1
        fi
        cat "$FIXTURES_DIR/path.json"
        ;;
    *"hub.docker.com/v2/repositories/"*"/tags/?name="*)
        # Extract edition (ce or ee) from URL path
        edition=$(echo "$url" | sed -n 's|.*gitlab/gitlab-\([^/]*\)/.*|\1|p')
        # Extract major version from name= parameter
        major=$(echo "$url" | sed -n 's/.*name=\([0-9]*\)\..*/\1/p')
        if [ -z "$major" ]; then
            major=$(echo "$url" | sed -n 's/.*name=\([0-9]*\).*/\1/p')
        fi
        fixture_file="$FIXTURES_DIR/dockerhub_${major}.json"
        if [ -f "$fixture_file" ]; then
            if [ -n "$edition" ]; then
                # Filter results to only include tags matching the requested edition
                jq --arg ed "$edition" '{count, next, results: [.results[] | select(.name | test("-" + $ed + "\\."))] }' "$fixture_file"
            else
                cat "$fixture_file"
            fi
        else
            echo '{"count":0,"next":null,"results":[]}'
        fi
        ;;
    *"hub.docker.com/v2/repositories/"*"/tags/"*)
        # Single tag check: extract the tag name and check if it exists in any fixture
        tag=$(echo "$url" | sed 's|.*/tags/||')
        # Search across all fixture files
        if grep -rq "\"$tag\"" "$FIXTURES_DIR"/dockerhub_*.json 2>/dev/null; then
            exit 0
        else
            exit 1
        fi
        ;;
    *"all-releases.xml"*)
        if [ "${MOCK_EOS_UNAVAIL:-0}" -eq 1 ]; then
            exit 1
        fi
        cat "$FIXTURES_DIR/all-releases.xml"
        ;;
    *"users/sign_in"*)
        # GitLab connectivity check. MOCK_READY_URL: only that address answers, like an
        # nginx that listens on one port; every other one is refused.
        [ -n "$MOCK_STATE_DIR" ] && printf '%s\n' "$*" >> "$MOCK_STATE_DIR/sign_in_curl_args"
        if [ -n "${MOCK_READY_URL:-}" ] && [ "$url" != "$MOCK_READY_URL" ]; then
            [ "$write_out" = "http_code" ] && echo "000"
            exit 7
        fi
        if [ "$write_out" = "http_code" ]; then
            echo "200"
        fi
        exit 0
        ;;
    *)
        exit 0
        ;;
esac
